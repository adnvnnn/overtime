@page "/orders"
@rendermode InteractiveServer
@inject AdminOrderService OrderService

<PageTitle>سفارش‌ها | مدیریت اورتایم</PageTitle>

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>مدیریت سفارش‌ها</h2>
            <p>@_orders.Count.ToFa() سفارش</p>
        </div>
    </div>

    <div class="table-toolbar">
        <label class="search-box">
            <Icon Name="search" Class="ic" />
            <input type="search" placeholder="جستجوی شماره سفارش…" value="@_query" @oninput="OnSearch" />
        </label>
        <select class="status-select" @onchange="OnStatusFilterChange">
            <option value="">همه وضعیت‌ها</option>
            @foreach (var status in Enum.GetValues<OrderStatus>())
            {
                <option value="@status" selected="@(_statusFilter == status)">@StatusLabel(status)</option>
            }
        </select>
    </div>

    @if (_orders.Count == 0)
    {
        <div class="empty-state"><Icon Name="receipt" Class="ic" />سفارشی یافت نشد.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>شماره سفارش</th>
                        <th>تاریخ ثبت</th>
                        <th>اقلام</th>
                        <th>مبلغ</th>
                        <th>وضعیت</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in _orders)
                    {
                        <tr>
                            <td class="cell-title">@order.OrderNumber</td>
                            <td class="num">@order.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td class="num">@order.Items.Sum(i => i.Qty).ToFa()</td>
                            <td class="num">@order.Total.FormatToman()</td>
                            <td>
                                <select class="status-select" value="@order.Status" @onchange="e => OnStatusChange(order, e)">
                                    @foreach (var status in Enum.GetValues<OrderStatus>())
                                    {
                                        <option value="@status">@StatusLabel(status)</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <button class="icon-btn" type="button" aria-label="جزئیات" title="نمایش اقلام"
                                        @onclick="() => Toggle(order.Id)">
                                    <Icon Name="chevron-down" Class="ic" />
                                </button>
                            </td>
                        </tr>
                        @if (_expandedId == order.Id)
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="order-details">
                                        <div class="table-wrap">
                                            <table class="data-table">
                                                <thead>
                                                    <tr>
                                                        <th>محصول</th>
                                                        <th>سایز</th>
                                                        <th>تعداد</th>
                                                        <th>قیمت واحد</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in order.Items)
                                                    {
                                                        <tr>
                                                            <td>@item.ProductName</td>
                                                            <td class="num">@item.Size.ToFa()</td>
                                                            <td class="num">@item.Qty.ToFa()</td>
                                                            <td class="num">@item.UnitPrice.FormatToman()</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        @if (order.Status != OrderStatus.Cancelled)
                                        {
                                            <div class="order-actions">
                                                <button type="button" class="btn btn-ghost btn-sm"
                                                        @onclick="() => ShowCancelDialog(order)">
                                                    لغو سفارش
                                                </button>
                                            </div>
                                        }
                                        @if (order.Status == OrderStatus.Cancelled && !string.IsNullOrEmpty(order.CancellationReason))
                                        {
                                            <div class="cancellation-info">
                                                <strong>دلیل لغو:</strong> @order.CancellationReason
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_showCancelDialog && _selectedOrder != null)
{
    <div class="modal-overlay" @onclick="HideCancelDialog">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>لغو سفارش</h3>
                <button type="button" class="icon-btn modal-close" @onclick="HideCancelDialog">
                    <Icon Name="x" Class="ic" />
                </button>
            </div>
            <div class="modal-body">
                <p>شماره سفارش: <strong>@_selectedOrder.OrderNumber</strong></p>
                <label class="form-field">
                    <span>دلیل لغو (اختیاری)</span>
                    <textarea @bind="_cancelReason" placeholder="مثال: درخواست کاربر برای لغو"></textarea>
                </label>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" @onclick="HideCancelDialog">انصراف</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmCancel" disabled="@_isCancelling">
                    @if (_isCancelling)
                    {
                        <span>در حال لغو...</span>
                    }
                    else
                    {
                        <span>تایید لغو</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Order> _orders = [];
    private string _query = "";
    private OrderStatus? _statusFilter;
    private int? _expandedId;
    private bool _showCancelDialog;
    private Order? _selectedOrder;
    private string _cancelReason = "";
    private bool _isCancelling;

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh() => _orders = await OrderService.GetAllAsync(_statusFilter, _query);

    private async Task OnSearch(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        await Refresh();
    }

    private async Task OnStatusFilterChange(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _statusFilter = string.IsNullOrEmpty(value) ? null : Enum.Parse<OrderStatus>(value);
        await Refresh();
    }

    private async Task OnStatusChange(Order order, ChangeEventArgs e)
    {
        if (Enum.TryParse<OrderStatus>(e.Value?.ToString(), out var status))
        {
            await OrderService.UpdateStatusAsync(order.Id, status);
            order.Status = status;
        }
    }

    private void Toggle(int orderId) => _expandedId = _expandedId == orderId ? null : orderId;

    private void ShowCancelDialog(Order order)
    {
        _selectedOrder = order;
        _cancelReason = "";
        _showCancelDialog = true;
    }

    private void HideCancelDialog()
    {
        _showCancelDialog = false;
        _selectedOrder = null;
        _cancelReason = "";
    }

    private async Task ConfirmCancel()
    {
        if (_selectedOrder is null)
            return;

        _isCancelling = true;
        try
        {
            await OrderService.CancelOrderAsync(_selectedOrder.Id, _cancelReason);
            _selectedOrder.Status = OrderStatus.Cancelled;
            _selectedOrder.CancellationReason = _cancelReason;
            HideCancelDialog();
        }
        finally
        {
            _isCancelling = false;
        }
    }

    private static string StatusLabel(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "در انتظار",
        OrderStatus.Processing => "در حال پردازش",
        OrderStatus.Shipped => "ارسال شده",
        OrderStatus.Delivered => "تحویل شده",
        OrderStatus.Cancelled => "لغو شده",
        _ => status.ToString(),
    };
}
