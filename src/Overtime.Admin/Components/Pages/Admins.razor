@page "/admins"
@rendermode InteractiveServer
@inject AdminAccountService AdminAccountService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>مدیریت ادمین‌ها | مدیریت اورتایم</PageTitle>

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>مدیریت ادمین‌ها</h2>
            <p>@_admins.Count.ToFa() ادمین</p>
        </div>
        <button class="btn btn-primary btn-sm" type="button" @onclick="ToggleAddForm">
            <Icon Name="plus" Class="ic" />
            افزودن ادمین
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="auth-alert">@_error</div>
    }

    @if (_showAddForm)
    {
        <EditForm Model="_newAdmin" OnValidSubmit="CreateAsync" class="form-grid" style="margin-bottom:22px;">
            <DataAnnotationsValidator />
            <label class="auth-field">
                <span>نام کاربری</span>
                <InputText @bind-Value="_newAdmin.Username" />
                <ValidationMessage For="() => _newAdmin.Username" />
            </label>
            <label class="auth-field">
                <span>نام کامل (اختیاری)</span>
                <InputText @bind-Value="_newAdmin.FullName" />
            </label>
            <label class="auth-field">
                <span>رمز عبور</span>
                <InputText @bind-Value="_newAdmin.Password" type="password" />
                <ValidationMessage For="() => _newAdmin.Password" />
            </label>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-sm">ذخیره</button>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="ToggleAddForm">انصراف</button>
            </div>
        </EditForm>
    }

    @if (_admins.Count == 0)
    {
        <div class="empty-state"><Icon Name="users" Class="ic" />ادمینی یافت نشد.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>نام کاربری</th>
                        <th>نام کامل</th>
                        <th>تاریخ ایجاد</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var admin in _admins)
                    {
                        <tr>
                            <td class="cell-title" dir="ltr" style="text-align:end">@admin.Username</td>
                            <td>@(admin.FullName ?? "—")</td>
                            <td class="num">@admin.CreatedAt.ToString("yyyy/MM/dd")</td>
                            <td>
                                <div class="row-actions">
                                    <button class="icon-btn" type="button" aria-label="تغییر رمز عبور" title="تغییر رمز عبور" @onclick="() => ToggleReset(admin.Id)">
                                        <Icon Name="lock" Class="ic" />
                                    </button>
                                    @if (admin.Id != _currentAdminId)
                                    {
                                        @if (_confirmDeleteId == admin.Id)
                                        {
                                            <button class="btn btn-danger btn-sm" type="button" @onclick="() => DeleteAsync(admin.Id)">تایید حذف</button>
                                            <button class="icon-btn" type="button" aria-label="انصراف" @onclick="() => _confirmDeleteId = null">
                                                <Icon Name="x" Class="ic" />
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="icon-btn" type="button" aria-label="حذف" title="حذف" @onclick="() => _confirmDeleteId = admin.Id">
                                                <Icon Name="trash-2" Class="ic" />
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                        @if (_resetId == admin.Id)
                        {
                            <tr>
                                <td colspan="4">
                                    <div class="size-row">
                                        <label>
                                            <span>رمز عبور جدید</span>
                                            <input type="password" @bind="_newPassword" />
                                        </label>
                                        <button class="btn btn-primary btn-sm" type="button" @onclick="() => ResetPasswordAsync(admin.Id)">ذخیره رمز جدید</button>
                                        <button class="icon-btn" type="button" aria-label="انصراف" @onclick="() => _resetId = null">
                                            <Icon Name="x" Class="ic" />
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>
