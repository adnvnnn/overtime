@page "/brands"
@rendermode InteractiveServer
@inject AdminBrandService BrandService

<PageTitle>مدیریت برندها | مدیریت اورتایم</PageTitle>

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>مدیریت برندها</h2>
            <p>@_brands.Count.ToFa() برند</p>
        </div>
        <button class="btn btn-primary btn-sm" type="button" @onclick="ShowAddForm">
            <Icon Name="plus" Class="ic" />
            افزودن برند
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="auth-alert">@_error</div>
    }

    @if (_showForm)
    {
        <EditForm Model="_formModel" OnValidSubmit="SaveAsync" class="form-grid" style="margin-bottom:22px;">
            <label class="auth-field">
                <span>نام برند</span>
                <InputText @bind-Value="_formModel.Name" />
            </label>
            <label class="auth-field">
                <span>نامک (Slug)</span>
                <InputText @bind-Value="_formModel.Slug" placeholder="مثال: nike" dir="ltr" />
            </label>
            <label class="auth-field">
                <span>آدرس لوگو (اختیاری)</span>
                <input list="brandLogos" @bind="_formModel.LogoUrl" placeholder="assets/images/brands/nike-logo.svg" dir="ltr" />
                <datalist id="brandLogos">
                    @foreach (var logo in KnownLogoFiles)
                    {
                        <option value="@logo"></option>
                    }
                </datalist>
            </label>
            <label class="auth-field">
                <span>ترتیب نمایش</span>
                <InputNumber @bind-Value="_formModel.DisplayOrder" />
            </label>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-sm">ذخیره</button>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="CancelForm">انصراف</button>
            </div>
        </EditForm>
    }

    @if (_brands.Count == 0)
    {
        <div class="empty-state"><Icon Name="package" Class="ic" />برندی یافت نشد.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>لوگو</th>
                        <th>نام</th>
                        <th>نامک</th>
                        <th>تعداد محصول</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var brand in _brands)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(brand.LogoUrl))
                                {
                                    <img src="@brand.LogoUrl" alt="@brand.Name" style="width:28px;height:28px;object-fit:contain;" />
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td class="cell-title">@brand.Name</td>
                            <td dir="ltr" style="text-align:end">@brand.Slug</td>
                            <td class="num">@brand.Products.Count.ToFa()</td>
                            <td>
                                <div class="row-actions">
                                    <button class="icon-btn" type="button" aria-label="ویرایش" title="ویرایش" @onclick="() => ShowEditForm(brand)">
                                        <Icon Name="pencil" Class="ic" />
                                    </button>
                                    @if (_confirmDeleteId == brand.Id)
                                    {
                                        <button class="btn btn-danger btn-sm" type="button" @onclick="() => DeleteAsync(brand.Id)">تایید حذف</button>
                                        <button class="icon-btn" type="button" aria-label="انصراف" @onclick="() => _confirmDeleteId = null">
                                            <Icon Name="x" Class="ic" />
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="icon-btn" type="button" aria-label="حذف" title="حذف" @onclick="() => _confirmDeleteId = brand.Id">
                                            <Icon Name="trash-2" Class="ic" />
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private static readonly string[] KnownLogoFiles =
    [
        "assets/images/brands/nike-logo.svg",
        "assets/images/brands/adidas-logo.svg",
        "assets/images/brands/airjordan-logo.svg",
        "assets/images/brands/new-balance-logo.svg",
        "assets/images/brands/puma-logo.svg",
        "assets/images/brands/asics-logo.svg",
        "assets/images/brands/reebok-logo.svg",
        "assets/images/brands/converse-logo.svg",
        "assets/images/brands/hoka-logo.svg",
        "assets/images/brands/salomon-logo.svg",
        "assets/images/brands/saucony-logo.svg",
        "assets/images/brands/skechers-logo.svg",
        "assets/images/brands/brooks-logo.svg",
        "assets/images/brands/mizuno-logo.svg",
        "assets/images/brands/under-armour-logo.svg",
        "assets/images/brands/fila-logo.svg",
        "assets/images/brands/timberland-logo.svg",
        "assets/images/brands/columbia-logo.svg",
        "assets/images/brands/lacoste-logo.svg",
        "assets/images/brands/diesel-logo.svg",
        "assets/images/brands/amiri-logo.svg",
        "assets/images/brands/balenciaga-logo.svg",
        "assets/images/brands/louis-vuitton-logo.svg",
        "assets/images/brands/alexander-macqueen-logo.svg",
        "assets/images/brands/vico-logo.svg",
    ];

    private List<Brand> _brands = [];
    private bool _showForm;
    private Brand _formModel = new();
    private string? _error;
    private int? _confirmDeleteId;

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh() => _brands = await BrandService.GetAllAsync();

    private void ShowAddForm()
    {
        _formModel = new();
        _showForm = true;
        _error = null;
    }

    private void ShowEditForm(Brand brand)
    {
        _formModel = new Brand
        {
            Id = brand.Id,
            Name = brand.Name,
            Slug = brand.Slug,
            LogoUrl = brand.LogoUrl,
            DisplayOrder = brand.DisplayOrder,
        };
        _showForm = true;
        _error = null;
    }

    private void CancelForm()
    {
        _showForm = false;
        _error = null;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_formModel.Name))
        {
            _error = "نام برند را وارد کنید.";
            return;
        }

        var (ok, error) = _formModel.Id == 0
            ? await BrandService.CreateAsync(_formModel)
            : await BrandService.UpdateAsync(_formModel);

        if (!ok)
        {
            _error = error;
            return;
        }

        _showForm = false;
        _error = null;
        await Refresh();
    }

    private async Task DeleteAsync(int id)
    {
        var (ok, error) = await BrandService.DeleteAsync(id);
        _confirmDeleteId = null;
        if (!ok)
        {
            _error = error;
            return;
        }
        await Refresh();
    }
}
