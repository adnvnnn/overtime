@page "/customers"
@rendermode InteractiveServer
@inject AdminCustomerService CustomerService

<PageTitle>مشتریان | مدیریت اورتایم</PageTitle>

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>مشتریان ثبت‌نامی</h2>
            <p>@_customers.Count.ToFa() مشتری</p>
        </div>
    </div>

    <div class="table-toolbar">
        <label class="search-box">
            <Icon Name="search" Class="ic" />
            <input type="search" placeholder="جستجوی شماره موبایل…" value="@_query" @oninput="OnSearch" />
        </label>
    </div>

    @if (_customers.Count == 0)
    {
        <div class="empty-state"><Icon Name="users" />مشتری‌ای یافت نشد.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>شماره موبایل</th>
                        <th>نام</th>
                        <th>تاریخ عضویت</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in _customers)
                    {
                        <tr>
                            <td class="cell-title" dir="ltr" style="text-align:end">@customer.PhoneNumber</td>
                            <td>@(customer.FullName ?? "—")</td>
                            <td class="num">@customer.CreatedAt.ToString("yyyy/MM/dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<User> _customers = [];
    private string _query = "";

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh() => _customers = await CustomerService.GetAllAsync(_query);

    private async Task OnSearch(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        await Refresh();
    }
}
