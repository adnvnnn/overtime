@page "/banners"
@rendermode InteractiveServer
@inject AdminBannerService BannerService

<PageTitle>مدیریت بنرها | مدیریت اورتایم</PageTitle>

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>مدیریت بنرها</h2>
            <p>@_banners.Count.ToFa() بنر</p>
        </div>
        <button class="btn btn-primary btn-sm" type="button" @onclick="ShowAddForm">
            <Icon Name="plus" Class="ic" />
            افزودن بنر
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="auth-alert">@_error</div>
    }

    @if (_showForm)
    {
        <EditForm Model="_formModel" OnValidSubmit="SaveAsync" class="form-grid" style="margin-bottom:22px;">
            <label class="auth-field">
                <span>نوع بنر</span>
                <InputSelect @bind-Value="_formModel.Kind">
                    <option value="@BannerKind.Hero">هیرو (اسلایدر)</option>
                    <option value="@BannerKind.Promo">بنر تبلیغاتی</option>
                </InputSelect>
            </label>
            <label class="auth-field">
                <span>آدرس تصویر</span>
                <input list="bannerImages" @bind="_formModel.ImageUrl" placeholder="assets/images/products/product-1.jpg" dir="ltr" />
                <datalist id="bannerImages">
                    @foreach (var image in KnownImageFiles)
                    {
                        <option value="@image"></option>
                    }
                </datalist>
            </label>
            <label class="auth-field">
                <span>برچسب (اختیاری)</span>
                <InputText @bind-Value="_formModel.Badge" placeholder="مثال: جدید" />
            </label>
            <label class="auth-field">
                <span>عنوان (اختیاری)</span>
                <InputText @bind-Value="_formModel.Title" placeholder="مثال: Air Pulse" />
            </label>
            <label class="auth-field">
                <span>قیمت به تومان (اختیاری)</span>
                <InputNumber @bind-Value="_formModel.Price" placeholder="مثال: 2950000" />
            </label>
            <label class="auth-field">
                <span>لینک مقصد (اختیاری)</span>
                <InputText @bind-Value="_formModel.LinkUrl" placeholder="/product/air-pulse" dir="ltr" />
            </label>
            <label class="auth-field">
                <span>ترتیب نمایش</span>
                <InputNumber @bind-Value="_formModel.DisplayOrder" />
            </label>
            <label class="auth-field">
                <span>وضعیت</span>
                <label class="checkbox-chip">
                    <InputCheckbox @bind-Value="_formModel.IsActive" />
                    <span>فعال</span>
                </label>
            </label>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-sm">ذخیره</button>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="CancelForm">انصراف</button>
            </div>
        </EditForm>
    }

    @if (_banners.Count == 0)
    {
        <div class="empty-state"><Icon Name="image" Class="ic" />بنری یافت نشد.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>تصویر</th>
                        <th>نوع</th>
                        <th>عنوان / برچسب</th>
                        <th>ترتیب</th>
                        <th>فعال</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var banner in _banners)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(banner.ImageUrl))
                                {
                                    <img src="@banner.ImageUrl" alt="" style="width:28px;height:28px;object-fit:cover;border-radius:6px;" />
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td>@KindLabel(banner.Kind)</td>
                            <td class="cell-title">@(banner.Title ?? banner.Badge ?? "—")</td>
                            <td class="num">@banner.DisplayOrder.ToFa()</td>
                            <td>@(banner.IsActive ? "✓" : "—")</td>
                            <td>
                                <div class="row-actions">
                                    <button class="icon-btn" type="button" aria-label="ویرایش" title="ویرایش" @onclick="() => ShowEditForm(banner)">
                                        <Icon Name="pencil" Class="ic" />
                                    </button>
                                    @if (_confirmDeleteId == banner.Id)
                                    {
                                        <button class="btn btn-danger btn-sm" type="button" @onclick="() => DeleteAsync(banner.Id)">تایید حذف</button>
                                        <button class="icon-btn" type="button" aria-label="انصراف" @onclick="() => _confirmDeleteId = null">
                                            <Icon Name="x" Class="ic" />
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="icon-btn" type="button" aria-label="حذف" title="حذف" @onclick="() => _confirmDeleteId = banner.Id">
                                            <Icon Name="trash-2" Class="ic" />
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private static readonly string[] KnownImageFiles =
    [
        "assets/images/products/product-1.jpg",
        "assets/images/products/product-2.jpg",
        "assets/images/products/product-3.jpg",
        "assets/images/products/product-4.jpg",
        "assets/images/products/product-5.jpg",
        "assets/images/products/product-6.jpg",
        "assets/images/products/product-7.jpg",
        "assets/images/products/product-8.jpg",
        "assets/images/products/product-9.jpg",
        "assets/images/products/product-12.jpg",
        "assets/images/products/product-91.jpg",
    ];

    private List<Banner> _banners = [];
    private bool _showForm;
    private Banner _formModel = new();
    private string? _error;
    private int? _confirmDeleteId;

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh() => _banners = await BannerService.GetAllAsync();

    private static string KindLabel(BannerKind kind) => kind switch
    {
        BannerKind.Hero => "هیرو",
        BannerKind.Promo => "بنر تبلیغاتی",
        _ => kind.ToString(),
    };

    private void ShowAddForm()
    {
        _formModel = new() { IsActive = true };
        _showForm = true;
        _error = null;
    }

    private void ShowEditForm(Banner banner)
    {
        _formModel = new Banner
        {
            Id = banner.Id,
            Kind = banner.Kind,
            ImageUrl = banner.ImageUrl,
            Badge = banner.Badge,
            Title = banner.Title,
            Price = banner.Price,
            LinkUrl = banner.LinkUrl,
            DisplayOrder = banner.DisplayOrder,
            IsActive = banner.IsActive,
        };
        _showForm = true;
        _error = null;
    }

    private void CancelForm()
    {
        _showForm = false;
        _error = null;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_formModel.ImageUrl))
        {
            _error = "آدرس تصویر را وارد کنید.";
            return;
        }

        var (ok, error) = _formModel.Id == 0
            ? await BannerService.CreateAsync(_formModel)
            : await BannerService.UpdateAsync(_formModel);

        if (!ok)
        {
            _error = error;
            return;
        }

        _showForm = false;
        _error = null;
        await Refresh();
    }

    private async Task DeleteAsync(int id)
    {
        var (ok, error) = await BannerService.DeleteAsync(id);
        _confirmDeleteId = null;
        if (!ok)
        {
            _error = error;
            return;
        }
        await Refresh();
    }
}
