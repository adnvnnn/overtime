@page "/products"
@rendermode InteractiveServer
@inject AdminProductService ProductService

<PageTitle>محصولات | مدیریت اورتایم</PageTitle>

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>مدیریت محصولات</h2>
            <p>@_products.Count.ToFa() محصول</p>
        </div>
        <a class="btn btn-primary btn-sm" href="/products/new">
            <Icon Name="plus" Class="ic" />
            افزودن محصول
        </a>
    </div>

    <div class="table-toolbar">
        <label class="search-box">
            <Icon Name="search" Class="ic" />
            <input type="search" placeholder="جستجوی محصول…" value="@_query" @oninput="OnSearch" />
        </label>
    </div>

    @if (_products.Count == 0)
    {
        <div class="empty-state"><Icon Name="package" Class="ic" />محصولی یافت نشد.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>نام محصول</th>
                        <th>برند</th>
                        <th>دسته‌بندی</th>
                        <th>قیمت</th>
                        <th>موجودی</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in _products)
                    {
                        <tr>
                            <td class="cell-title">@product.Name</td>
                            <td>@product.Brand?.Name</td>
                            <td>@product.Category@(string.IsNullOrEmpty(product.Usage) ? "" : $" · {product.Usage}")</td>
                            <td class="num">@product.Price.FormatToman()</td>
                            <td class="num">@product.Sizes.Sum(s => s.StockQty).ToFa()</td>
                            <td>
                                <div class="row-actions">
                                    <a class="icon-btn" href="@($"/products/{product.Id}/edit")" aria-label="ویرایش" title="ویرایش">
                                        <Icon Name="pencil" Class="ic" />
                                    </a>
                                    @if (_confirmDeleteId == product.Id)
                                    {
                                        <button class="btn btn-danger btn-sm" type="button" @onclick="() => DeleteAsync(product.Id)">تایید حذف</button>
                                        <button class="icon-btn" type="button" aria-label="انصراف" @onclick="() => _confirmDeleteId = null">
                                            <Icon Name="x" Class="ic" />
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="icon-btn" type="button" aria-label="حذف" title="حذف" @onclick="() => _confirmDeleteId = product.Id">
                                            <Icon Name="trash-2" Class="ic" />
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Product> _products = [];
    private string _query = "";
    private string? _confirmDeleteId;

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh() => _products = await ProductService.GetAllAsync(_query);

    private async Task OnSearch(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        await Refresh();
    }

    private async Task DeleteAsync(string id)
    {
        await ProductService.DeleteAsync(id);
        _confirmDeleteId = null;
        await Refresh();
    }
}
