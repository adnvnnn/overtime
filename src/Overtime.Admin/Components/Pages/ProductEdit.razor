@page "/products/new"
@page "/products/{Id}/edit"
@rendermode InteractiveServer
@inject AdminProductService ProductService
@inject AdminBrandService BrandService
@inject NavigationManager NavigationManager

<PageTitle>@(IsNew ? "افزودن محصول" : "ویرایش محصول") | مدیریت اورتایم</PageTitle>

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>@(IsNew ? "افزودن محصول جدید" : $"ویرایش «{_model.Name}»")</h2>
            <p>@(IsNew ? "اطلاعات محصول جدید را وارد کنید" : "اطلاعات محصول را ویرایش کنید")</p>
        </div>
        <a class="btn btn-ghost btn-sm" href="/products">بازگشت به فهرست</a>
    </div>

    @if (!_loaded)
    {
        <div class="empty-state">در حال بارگذاری...</div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="auth-alert">@_error</div>
        }

        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="form-grid">
                <label class="auth-field">
                    <span>نام محصول</span>
                    <InputText @bind-Value="_model.Name" />
                    <ValidationMessage For="() => _model.Name" />
                </label>
                <label class="auth-field">
                    <span>برند</span>
                    <InputSelect @bind-Value="_model.BrandId">
                        <option value="0">— انتخاب برند —</option>
                        @foreach (var brand in _brands)
                        {
                            <option value="@brand.Id">@brand.Name</option>
                        }
                    </InputSelect>
                </label>
                <label class="auth-field">
                    <span>دسته‌بندی</span>
                    <InputText @bind-Value="_model.Category" placeholder="مثال: مردانه" />
                    <ValidationMessage For="() => _model.Category" />
                </label>
                <label class="auth-field">
                    <span>کاربرد</span>
                    <InputText @bind-Value="_model.Usage" placeholder="مثال: رانینگ" />
                    <ValidationMessage For="() => _model.Usage" />
                </label>
                <label class="auth-field">
                    <span>قیمت (تومان)</span>
                    <InputNumber @bind-Value="_model.Price" />
                    <ValidationMessage For="() => _model.Price" />
                </label>
                <label class="auth-field">
                    <span>برچسب (اختیاری)</span>
                    <InputText @bind-Value="_model.Badge" placeholder="مثال: جدید، پرفروش، تخفیف" />
                </label>
                <label class="auth-field span-2">
                    <span>توضیحات</span>
                    <InputTextArea @bind-Value="_model.Description" rows="4" />
                </label>
                <label class="auth-field">
                    <span>ترتیب نمایش</span>
                    <InputNumber @bind-Value="_model.DisplayOrder" />
                </label>
            </div>

            <div class="panel-head" style="margin-top:26px;">
                <div>
                    <h2>سایزهای موجود</h2>
                    <p>سایزهای دلخواه این محصول را اضافه کرده و موجودی هرکدام را وارد کنید</p>
                </div>
            </div>
            <div class="size-row-list">
                @foreach (var row in _sizeRows)
                {
                    <div class="size-row" @key="row.Key">
                        <label>
                            <span>سایز</span>
                            <input type="number" min="1" placeholder="مثلاً ۴۲" value="@row.Size"
                                   @onchange="e => OnSizeValueChanged(row, e)" />
                        </label>
                        <label>
                            <span>موجودی</span>
                            <input type="number" min="0" value="@row.StockQty"
                                   @onchange="e => OnStockChanged(row, e)" />
                        </label>
                        <button type="button" class="icon-btn" aria-label="حذف سایز" title="حذف سایز" @onclick="() => RemoveSize(row)">
                            <Icon Name="trash-2" Class="ic" />
                        </button>
                    </div>
                }
                <button type="button" class="btn btn-ghost btn-sm" @onclick="AddSizeRow">
                    <Icon Name="plus" Class="ic" />
                    افزودن سایز
                </button>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <Icon Name="check-circle" Class="ic" />
                    ذخیره تغییرات
                </button>
                <a class="btn btn-ghost" href="/products">انصراف</a>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public string? Id { get; set; }

    private bool IsNew => Id is null;
    private bool _loaded;
    private string? _error;
    private Product _model = new();
    private List<Brand> _brands = [];
    private List<SizeRow> _sizeRows = [];
    private int _nextRowKey;

    private sealed class SizeRow
    {
        public int Key { get; set; }
        public int Size { get; set; }
        public int StockQty { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _brands = await BrandService.GetAllAsync();

        if (!IsNew)
        {
            var existing = await ProductService.GetByIdAsync(Id!);
            if (existing is null)
            {
                _error = "محصول یافت نشد.";
                _loaded = true;
                return;
            }
            _model = existing;
        }

        _sizeRows = _model.Sizes
            .OrderBy(s => s.Size)
            .Select(s => new SizeRow { Key = _nextRowKey++, Size = s.Size, StockQty = s.StockQty })
            .ToList();

        _loaded = true;
    }

    private void AddSizeRow() => _sizeRows.Add(new SizeRow { Key = _nextRowKey++ });

    private void RemoveSize(SizeRow row) => _sizeRows.Remove(row);

    private void OnSizeValueChanged(SizeRow row, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
            row.Size = Math.Max(0, size);
    }

    private void OnStockChanged(SizeRow row, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var qty))
            row.StockQty = Math.Max(0, qty);
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Name) || _model.BrandId <= 0 ||
            string.IsNullOrWhiteSpace(_model.Category) || _model.Price <= 0)
        {
            _error = "نام، برند، دسته‌بندی و قیمت محصول را به‌درستی وارد کنید.";
            return;
        }

        var enteredSizes = _sizeRows.Where(r => r.Size > 0).ToList();

        if (enteredSizes.Count == 0)
        {
            _error = "حداقل یک سایز اضافه کنید.";
            return;
        }

        if (enteredSizes.Select(r => r.Size).Distinct().Count() != enteredSizes.Count)
        {
            _error = "سایزهای تکراری وارد شده است.";
            return;
        }

        var chosenSizes = enteredSizes
            .Select(r => new ProductSize { Size = r.Size, StockQty = r.StockQty })
            .ToList();

        if (IsNew)
        {
            _model.Sizes = chosenSizes;
            await ProductService.CreateAsync(_model);
        }
        else
        {
            await ProductService.UpdateAsync(_model);
            await ProductService.UpdateSizesAsync(_model.Id, chosenSizes);
        }
        NavigationManager.NavigateTo("/products");
    }
}
