@inject ProductService ProductService
@inject IJSRuntime JS
@inject IStringLocalizer<AppStrings> Localizer
@implements IAsyncDisposable

<section id="carousel" class="carousel-section">
    <div class="wrap">
        <div class="sec-head">
            <div>
                <p class="eyebrow">@Localizer["Carousel_Eyebrow"]</p>
                <h2>@Localizer["Carousel_Heading"]</h2>
            </div>
            <p class="lede">@Localizer["Carousel_Lede"]</p>
        </div>
        <div class="carousel-container">
            <div class="carousel-track" @ref="_trackRef">
                @foreach (var product in _products)
                {
                    <div class="carousel-item">
                        <ProductCard Product="product" />
                    </div>
                }
            </div>
            <button type="button" class="carousel-btn carousel-prev" @onclick="ManualPrev" aria-label="@Localizer["Carousel_PrevAria"]">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </button>
            <button type="button" class="carousel-btn carousel-next" @onclick="ManualNext" aria-label="@Localizer["Carousel_NextAria"]">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>
        </div>
        <div class="carousel-dots">
            @for (int i = 0; i <= _maxIndex; i++)
            {
                var index = i;
                <button type="button" class="dot @(_currentIndex == index ? "active" : "")"
                        @onclick="() => ManualGoToSlide(index)"
                        aria-label="@Localizer["Carousel_GoToProductAria", index + 1]">
                </button>
            }
        </div>
    </div>
</section>

@code {
    private List<Product> _products = [];
    private int _currentIndex = 0;
    private int _maxIndex = 0;
    private ElementReference _trackRef;
    private DotNetObjectReference<Carousel>? _dotNetRef;
    private IJSObjectReference? _carouselHandle;
    private CancellationTokenSource? _autoScrollCts;
    private bool _isVisible;
    private bool _isHovering;

    protected override async Task OnInitializedAsync()
    {
        _products = await ProductService.GetTopAsync(8);
        _maxIndex = Math.Max(0, _products.Count - 1);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _products.Count > 0)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _carouselHandle = await JS.InvokeAsync<IJSObjectReference>("overtimeCarousel.attach", _trackRef, _dotNetRef);

            RestartAutoScroll();
        }
    }

    [JSInvokable]
    public void OnMaxIndexChanged(int maxIndex)
    {
        _maxIndex = maxIndex;
        if (_currentIndex > _maxIndex)
            _currentIndex = _maxIndex;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnVisibilityChanged(bool isVisible)
    {
        _isVisible = isVisible;
    }

    [JSInvokable]
    public void OnHoverChanged(bool isHovering)
    {
        _isHovering = isHovering;
    }

    // Manual navigation restarts the auto-scroll countdown so a click doesn't
    // get followed a moment later by an auto-advance the user didn't ask for.
    private Task ManualNext()
    {
        RestartAutoScroll();
        return NextSlide();
    }

    private Task ManualPrev()
    {
        RestartAutoScroll();
        return PrevSlide();
    }

    private Task ManualGoToSlide(int index)
    {
        RestartAutoScroll();
        return GoToSlide(index);
    }

    private Task NextSlide()
    {
        var next = (_currentIndex + 1) % (_maxIndex + 1);
        var wrapped = next < _currentIndex;
        _currentIndex = next;
        return ScrollToCurrentAsync(smooth: !wrapped);
    }

    private Task PrevSlide()
    {
        var prev = (_currentIndex - 1 + _maxIndex + 1) % (_maxIndex + 1);
        var wrapped = prev > _currentIndex;
        _currentIndex = prev;
        return ScrollToCurrentAsync(smooth: !wrapped);
    }

    private Task GoToSlide(int index)
    {
        _currentIndex = index;
        return ScrollToCurrentAsync();
    }

    // Wrapping past the last/first slide snaps instantly instead of smooth-
    // scrolling across the whole track — otherwise "next" from the last slide
    // back to the first plays a long, jarring reverse traversal of every item
    // in between instead of reading as a quick reset to the start.
    private async Task ScrollToCurrentAsync(bool smooth = true)
    {
        await JS.InvokeVoidAsync("overtimeCarousel.scrollToIndex", _trackRef, _currentIndex, smooth);
    }

    private void RestartAutoScroll()
    {
        _autoScrollCts?.Cancel();
        _autoScrollCts?.Dispose();
        _autoScrollCts = new CancellationTokenSource();
        _ = RunAutoScrollAsync(_autoScrollCts.Token);
    }

    private async Task RunAutoScrollAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(5000, token);
                if (!_isVisible || _isHovering)
                    continue;
                await NextSlide();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _autoScrollCts?.Cancel();
        _autoScrollCts?.Dispose();

        if (_carouselHandle is not null)
        {
            try
            {
                await _carouselHandle.InvokeVoidAsync("dispose");
                await _carouselHandle.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
        _dotNetRef?.Dispose();
    }
}
