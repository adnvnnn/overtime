@inject ProductService ProductService

<section id="carousel" class="carousel-section">
    <div class="wrap">
        <div class="sec-head">
            <div>
                <p class="eyebrow">محصولات برجسته</p>
                <h2>کالکشن برتر این فصل</h2>
            </div>
            <p class="lede">بهترین انتخاب‌های ما برای شما؛ محصولات پرطرفدار و جدید اورتایم.</p>
        </div>
        @if (_slides.Count > 0)
        {
            <CascadingValue Name="RightToLeft" Value="true">
                <MudCarousel TData="object" Class="carousel-mud" ShowArrows="_slides.Count > 1" ShowBullets="_slides.Count > 1"
                             AutoCycle="_slides.Count > 1" AutoCycleTime="TimeSpan.FromSeconds(5)"
                             ArrowsColor="Color.Default" BulletsColor="Color.Primary">
                    @foreach (var slide in _slides)
                    {
                        <MudCarouselItem Transition="Transition.Slide">
                            <div class="carousel-grid">
                                @foreach (var product in slide)
                                {
                                    <ProductCard Product="product" />
                                }
                            </div>
                        </MudCarouselItem>
                    }
                </MudCarousel>
            </CascadingValue>
        }
    </div>
</section>

@code {
    private const int SlideSize = 4;
    private List<List<Product>> _slides = [];

    protected override async Task OnInitializedAsync()
    {
        var products = await ProductService.GetTopAsync(8);
        _slides = products.Chunk(SlideSize).Select(chunk => chunk.ToList()).ToList();
    }
}
