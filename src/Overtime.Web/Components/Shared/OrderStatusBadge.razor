@using Overtime.Data.Entities
@inject IStringLocalizer<AppStrings> Localizer

<span class="order-status-badge @CssClass">@Label</span>

@code {
    [Parameter, EditorRequired]
    public OrderStatus Status { get; set; }

    private string CssClass => Status switch
    {
        OrderStatus.Pending => "status-pending",
        OrderStatus.Processing => "status-processing",
        OrderStatus.Shipped => "status-shipped",
        OrderStatus.Delivered => "status-delivered",
        OrderStatus.Cancelled => "status-cancelled",
        _ => "",
    };

    private string Label => Status switch
    {
        OrderStatus.Pending => Localizer["Order_StatusPending"],
        OrderStatus.Processing => Localizer["Order_StatusProcessing"],
        OrderStatus.Shipped => Localizer["Order_StatusShipped"],
        OrderStatus.Delivered => Localizer["Order_StatusDelivered"],
        OrderStatus.Cancelled => Localizer["Order_StatusCancelled"],
        _ => Status.ToString(),
    };
}
