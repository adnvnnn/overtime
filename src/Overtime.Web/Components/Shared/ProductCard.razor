@inject CartService CartService
@inject ToastService ToastService
@inject IStringLocalizer<AppStrings> Localizer

<article class="card">
    <a class="card-link" href="@($"/product/{Product.Slug}")" aria-label="@Localizer["ProductCard_ViewDetailsAria", Product.Name]">
        <div class="plate" style="background: color-mix(in srgb, var(@SwatchVar) 14%, var(--surface-2));">
            @if (!string.IsNullOrEmpty(Product.Badge))
            {
                <span class="tag">@Product.Badge</span>
            }
            <img src="@MainImage" alt="@Product.Name" loading="lazy">
        </div>
    </a>
    <div class="body">
        <span class="cat-line">@CategoryLine</span>
        <h3><a href="@($"/product/{Product.Slug}")">@Product.Name</a></h3>
        <div class="row">
            <span class="price">@Product.Price.ToFa()<small>@Localizer["Common_Toman"]</small></span>
            <button class="add" type="button" disabled="@_added" @onclick="Add">@(_added ? Localizer["ProductCard_Added"] : Localizer["ProductCard_AddToCart"])</button>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public Product Product { get; set; } = null!;

    private bool _added;

    private string MainImage => Product.Images.Count > 0 ? Product.Images[0].Url : "";

    private string CategoryLine => string.Join(" · ",
        new[] { Product.Brand?.Name, string.Join("، ", Product.Categories.Select(c => c.Name)), string.Join("، ", Product.Usages.Select(u => u.Name)) }
            .Where(s => !string.IsNullOrEmpty(s)));

    private string SwatchVar => Product.Swatch switch
    {
        "accent-2" => "--accent-2",
        "ink" => "--ink",
        _ => "--accent",
    };

    private async Task Add()
    {
        var added = await CartService.QuickAddAsync(Product.Id);
        if (!added)
        {
            ToastService.ShowMessage(Localizer["ProductCard_OutOfStock"].Value);
            return;
        }

        ToastService.ShowMessage(Localizer["ProductCard_AddedToCart", Product.Name].Value);
        _added = true;
        StateHasChanged();
        await Task.Delay(1100);
        _added = false;
        StateHasChanged();
    }
}
