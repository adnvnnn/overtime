@implements IDisposable
@inject CartService CartService
@inject BrandService BrandService
@inject IJSRuntime JS
@inject CategoryService CategoryService
@inject IStringLocalizer<AppStrings> Localizer

<header>
    <div class="nav">
        <a class="brand" href="/">
            <span class="name">
                <span class="en wordmark">OVER<span class="t2">TIME</span></span>
                <span class="fa">@Localizer["Nav_Tagline"]</span>
            </span>
        </a>
        <div class="nav-backdrop @(_menuOpen ? "show" : "")" @onclick="CloseMenu"></div>
        <nav class="links @(_menuOpen ? "open" : "")" id="navLinks">
            <div class="drawer-head">
                <span class="drawer-brand en wordmark">OVER<span class="t2">TIME</span></span>
                <button type="button" class="drawer-close" aria-label="@Localizer["Common_CloseMenu"]" @onclick="CloseMenu">
                    <Icon Name="x" Class="ic" />
                </button>
            </div>
            <a href="/" @onclick="CloseMenu">@Localizer["Common_Home"]</a>
            <div class="nav-item @(_productsExpanded ? "expanded" : "")">
                <div class="nav-item-row">
                    <a href="/products" @onclick="CloseMenu">@Localizer["Common_Products"]</a>
                    <button type="button" class="nav-item-toggle" aria-expanded="@(_productsExpanded ? "true" : "false")" aria-controls="navProductsPanel" aria-label="@Localizer["Nav_ShowProductsSubmenu"]" @onclick="ToggleProducts"></button>
                </div>
                <div class="mega-menu" id="navProductsPanel">
                    <div class="mega-menu-inner">
                        <div class="mega-col mega-col-links">
                            <p class="mega-heading">@Localizer["Common_Categories"]</p>
                            @foreach (var category in _categories)
                            {
                                <a href="@($"/products?cat={category.Slug}")" @onclick="CloseMenu">@category.Name</a>
                            }
                            <a class="mega-view-all" href="/products" @onclick="CloseMenu">
                                @Localizer["Nav_ViewAllProducts"]
                                <Icon Name="chevron-left" Class="ic" />
                            </a>
                        </div>
                        <div class="mega-col mega-col-brands">
                            <p class="mega-heading">@Localizer["Common_Brands"]</p>
                            <div class="mega-brand-grid">
                                @foreach (var brand in _brands)
                                {
                                    <a class="mega-brand" href="@($"/products?brand={brand.Slug}")" @onclick="CloseMenu">
                                        <span class="mega-brand-logo">
                                            @if (!string.IsNullOrEmpty(brand.LogoUrl))
                                            {
                                                <img src="@brand.LogoUrl" alt="@brand.Name" loading="lazy" />
                                            }
                                            else
                                            {
                                                <span class="mega-brand-monogram">OT</span>
                                            }
                                        </span>
                                        <span>@brand.Name</span>
                                    </a>
                                }
                            </div>
                        </div>
                        <a class="mega-promo" href="/products?cat=limited-edition" @onclick="CloseMenu">
                            <img src="assets/images/products/product-6.jpg" alt="@Localizer["Nav_LimitedCollectionAlt"]" loading="lazy" />
                            <span class="mega-promo-overlay">
                                <span class="mega-promo-tag">@Localizer["Common_CategoryLimited"]</span>
                                <span class="mega-promo-text">
                                    @Localizer["Nav_ExclusiveCollection"]
                                    <Icon Name="chevron-left" Class="ic" />
                                </span>
                            </span>
                        </a>
                    </div>
                </div>
            </div>
            <a href="/about" @onclick="CloseMenu">@Localizer["Common_About"]</a>
            <div class="nav-mobile-actions">
                <a class="btn btn-primary btn-sm" href="/products" @onclick="CloseMenu">@Localizer["Nav_ViewProducts"]</a>
            </div>
        </nav>
        <div class="nav-cta">
            <button class="menu-btn" type="button" aria-expanded="@(_menuOpen ? "true" : "false")" aria-controls="navLinks" aria-label="@Localizer["Common_OpenMenu"]" @onclick="ToggleMenu">
                <Icon Name="menu" Class="ic ic-menu" />
                <Icon Name="x" Class="ic ic-close" />
            </button>
            <a class="btn btn-primary btn-sm" href="https://www.instagram.com/overtime_sneaker/" target="_blank" rel="noopener">
                <Icon Name="instagram" Class="ic" />
                @Localizer["Common_Instagram"]
            </a>
            <button class="cart-btn theme-btn" type="button" data-current="@_theme" aria-label="@Localizer["Nav_ToggleTheme"]" @onclick="ToggleTheme">
                <Icon Name="sun" Class="ic ic-sun" />
                <Icon Name="moon" Class="ic ic-moon" />
            </button>
            <button class="cart-btn" type="button" aria-haspopup="dialog" aria-controls="cartDrawer" aria-label="@Localizer["Common_Cart"]" @onclick="ToggleCart">
                <Icon Name="shopping-cart" Class="ic" />
                <span class="cart-count" data-empty="@(_count == 0 ? "true" : "false")">@_count.ToFa()</span>
            </button>
            <AuthorizeView>
                <Authorized>
                    <div class="user-menu">
                        <a class="cart-btn" href="/account" aria-label="@Localizer["Common_Account"]" title="@Localizer["Common_Account"]">
                            <Icon Name="user" Class="ic" />
                        </a>
                        <form method="post" action="/account/logout">
                            <AntiforgeryToken />
                            <button class="cart-btn" type="submit" aria-label="@Localizer["Nav_LogoutAria"]" title="@Localizer["Common_Logout"]">
                                <Icon Name="log-out" Class="ic" />
                            </button>
                        </form>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a class="cart-btn" href="/account/login" aria-label="@Localizer["Common_LoginRegister"]" title="@Localizer["Common_LoginRegister"]">
                        <Icon Name="user" Class="ic" />
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

@code {
    private bool _menuOpen;
    private bool _productsExpanded;
    private int _count;
    private string _theme = "light";
    private List<Brand> _brands = [];
    private List<Category> _categories = [];

    protected override async Task OnInitializedAsync()
    {
        CartService.Changed += OnCartChanged;
        _count = await CartService.GetCountAsync();
        _brands = await BrandService.GetAllAsync();
        _categories = await CategoryService.GetAllAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _theme = await JS.InvokeAsync<string>("overtimeTheme.current");
            StateHasChanged();
        }
    }

    private void OnCartChanged() => InvokeAsync(async () =>
    {
        _count = await CartService.GetCountAsync();
        StateHasChanged();
    });

    private Task ToggleMenu() => SetMenuOpen(!_menuOpen);
    private Task CloseMenu() => SetMenuOpen(false);
    private void ToggleCart() => CartService.ToggleDrawer();
    private void ToggleProducts() => _productsExpanded = !_productsExpanded;

    private async Task SetMenuOpen(bool open)
    {
        if (_menuOpen == open) return;
        _menuOpen = open;
        if (!open) _productsExpanded = false;
        await JS.InvokeVoidAsync("overtimeNav.setBodyScrollLock", open);
    }

    private async Task ToggleTheme() => _theme = await JS.InvokeAsync<string>("overtimeTheme.toggle");

    public void Dispose() => CartService.Changed -= OnCartChanged;
}
