@implements IDisposable
@inject CartService CartService
@inject BrandService BrandService
@inject IJSRuntime JS

<header>
    <div class="nav">
        <a class="brand" href="/">
            <span class="name">
                <span class="en wordmark">OVER<span class="t2">TIME</span></span>
                <span class="fa">فروشگاه کفش کتانی</span>
            </span>
        </a>
        <nav class="links @(_menuOpen ? "open" : "")" id="navLinks">
            <a href="/" @onclick="CloseMenu">خانه</a>
            <div class="nav-item">
                <a href="/products" @onclick="CloseMenu">محصولات</a>
                <div class="mega-menu">
                    <div class="mega-menu-inner">
                        <div class="mega-col mega-col-links">
                            <p class="mega-heading">دسته‌بندی‌ها</p>
                            <a href="/products?cat=مردانه" @onclick="CloseMenu">مردانه</a>
                            <a href="/products?cat=زنانه" @onclick="CloseMenu">زنانه</a>
                            <a href="/products?cat=بچگانه" @onclick="CloseMenu">بچگانه</a>
                            <a href="/products?cat=یونیسکس" @onclick="CloseMenu">یونیسکس</a>
                            <a href="/products?cat=لیمیتد" @onclick="CloseMenu">لیمیتد ادیشن</a>
                            <a class="mega-view-all" href="/products" @onclick="CloseMenu">
                                مشاهده همه محصولات
                                <Icon Name="chevron-left" Class="ic" />
                            </a>
                        </div>
                        <div class="mega-col mega-col-brands">
                            <p class="mega-heading">برندها</p>
                            <div class="mega-brand-grid">
                                @foreach (var brand in _brands)
                                {
                                    <a class="mega-brand" href="@($"/products?brand={brand.Slug}")" @onclick="CloseMenu">
                                        <span class="mega-brand-logo">
                                            @if (!string.IsNullOrEmpty(brand.LogoUrl))
                                            {
                                                <img src="@brand.LogoUrl" alt="@brand.Name" loading="lazy" />
                                            }
                                            else
                                            {
                                                <span class="mega-brand-monogram">OT</span>
                                            }
                                        </span>
                                        <span>@brand.Name</span>
                                    </a>
                                }
                            </div>
                        </div>
                        <a class="mega-promo" href="/products?cat=لیمیتد" @onclick="CloseMenu">
                            <img src="assets/images/products/product-6.jpg" alt="کالکشن لیمیتد اورتایم" loading="lazy" />
                            <span class="mega-promo-overlay">
                                <span class="mega-promo-tag">لیمیتد ادیشن</span>
                                <span class="mega-promo-text">
                                    کالکشن اختصاصی اورتایم
                                    <Icon Name="chevron-left" Class="ic" />
                                </span>
                            </span>
                        </a>
                    </div>
                </div>
            </div>
            <a href="/#categories" @onclick="CloseMenu">دسته‌بندی‌ها</a>
            <a href="/#why" @onclick="CloseMenu">چرا اورتایم</a>
            <a href="/#location" @onclick="CloseMenu">موقعیت فروشگاه</a>
            <div class="nav-mobile-actions">
                <a class="btn btn-primary btn-sm" href="/products" @onclick="CloseMenu">مشاهده محصولات</a>
            </div>
        </nav>
        <div class="nav-cta">
            <a class="btn btn-primary btn-sm" href="/products">مشاهده محصولات</a>
            <button class="cart-btn theme-btn" type="button" data-current="@_theme" aria-label="تغییر حالت روشن/تیره" @onclick="ToggleTheme">
                <Icon Name="sun" Class="ic ic-sun" />
                <Icon Name="moon" Class="ic ic-moon" />
            </button>
            <button class="cart-btn" type="button" aria-haspopup="dialog" aria-controls="cartDrawer" aria-label="سبد خرید" @onclick="ToggleCart">
                <Icon Name="shopping-cart" Class="ic" />
                <span class="cart-count" data-empty="@(_count == 0 ? "true" : "false")">@_count.ToFa()</span>
            </button>
            <AuthorizeView>
                <Authorized>
                    <div class="user-menu">
                        <a class="cart-btn" href="/account" aria-label="حساب کاربری" title="حساب کاربری">
                            <Icon Name="user" Class="ic" />
                        </a>
                        <form method="post" action="/account/logout">
                            <AntiforgeryToken />
                            <button class="cart-btn" type="submit" aria-label="خروج از حساب کاربری" title="خروج">
                                <Icon Name="log-out" Class="ic" />
                            </button>
                        </form>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a class="cart-btn" href="/account/login" aria-label="ورود / ثبت‌نام" title="ورود / ثبت‌نام">
                        <Icon Name="user" Class="ic" />
                    </a>
                </NotAuthorized>
            </AuthorizeView>
            <button class="menu-btn" type="button" aria-expanded="@(_menuOpen ? "true" : "false")" aria-controls="navLinks" aria-label="باز کردن منو" @onclick="ToggleMenu">
                <Icon Name="menu" Class="ic ic-menu" />
                <Icon Name="x" Class="ic ic-close" />
            </button>
        </div>
    </div>
</header>

@code {
    private bool _menuOpen;
    private int _count;
    private string _theme = "light";
    private List<Brand> _brands = [];

    protected override async Task OnInitializedAsync()
    {
        CartService.Changed += OnCartChanged;
        _count = await CartService.GetCountAsync();
        _brands = await BrandService.GetAllAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _theme = await JS.InvokeAsync<string>("overtimeTheme.current");
            StateHasChanged();
        }
    }

    private void OnCartChanged() => InvokeAsync(async () =>
    {
        _count = await CartService.GetCountAsync();
        StateHasChanged();
    });

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;
    private void ToggleCart() => CartService.ToggleDrawer();

    private async Task ToggleTheme() => _theme = await JS.InvokeAsync<string>("overtimeTheme.toggle");

    public void Dispose() => CartService.Changed -= OnCartChanged;
}
