@using Microsoft.Extensions.Options
@inject IOptions<FooterOptions> FooterOptionsAccessor

<footer>
    <div class="wrap footer-cols">
        <div class="footer-brand">
            <span class="wordmark" style="font-size:20px">OVER<span class="t2">TIME</span></span>
            <p class="footer-tagline">@_options.Tagline</p>
        </div>
        <div class="col">
            <b>@_options.QuickLinksTitle</b>
            @foreach (var link in _options.QuickLinks)
            {
                <a href="@link.Href">@link.Label</a>
            }
        </div>
        <div class="col">
            <b>@_options.ContactTitle</b>
            @foreach (var link in _options.ContactLinks)
            {
                <a href="@link.Href" target="@(link.External ? "_blank" : null)" rel="@(link.External ? "noopener" : null)">
                    @if (!string.IsNullOrEmpty(link.Icon))
                    {
                        <Icon Name="@link.Icon" Class="ic" />
                    }
                    @link.Label
                </a>
            }
        </div>
    </div>
    <div class="footer-bottom-bar">
        <div class="wrap">
            <p class="fine">@_options.FinePrint</p>
        </div>
    </div>
</footer>

@code {
    private FooterOptions _options => FooterOptionsAccessor.Value;
}
