@implements IDisposable
@using System.Security.Claims
@inject CartService CartService
@inject OrderService OrderService
@inject AddressService AddressService
@inject ToastService ToastService

<div class="cart-backdrop @(CartService.IsDrawerOpen ? "open" : "")" @onclick="Close"></div>
<aside class="cart-drawer @(CartService.IsDrawerOpen ? "open" : "")" id="cartDrawer" role="dialog" aria-modal="true"
       aria-label="سبد خرید" aria-hidden="@((!CartService.IsDrawerOpen).ToString().ToLowerInvariant())">
    <div class="cart-head">
        <h3>سبد خرید</h3>
        <button class="cart-close" type="button" aria-label="بستن سبد خرید" @onclick="Close">✕</button>
    </div>
    <div class="cart-body">
        @if (_orderNumber is not null)
        {
            <div class="cart-success">
                <div class="ok">✓</div>
                <h4>سفارش شما ثبت شد</h4>
                <p>این یک فروشگاه نمایشی است؛ همکاران اورتایم به‌زودی برای هماهنگی ارسال با شما تماس می‌گیرند.</p>
                <span class="ordno">شماره سفارش دمو: @_orderNumber</span>
                <button class="btn btn-ghost btn-sm" type="button" @onclick="Close">بستن</button>
            </div>
        }
        else if (_isAddressSelection)
        {
            <div class="cart-checkout-step">
                <h4>انتخاب آدرس ارسال</h4>
                @if (_addresses.Count == 0)
                {
                    <div class="no-address">
                        <p>هیچ آدرسی ثبت نشده است.</p>
                        <button class="btn btn-primary btn-sm" type="button" @onclick="GoToAddAddress">افزودن آدرس جدید</button>
                    </div>
                }
                else
                {
                    <div class="address-options">
                        @foreach (var address in _addresses)
                        {
                            <div class="address-option @(_selectedAddressId == address.Id ? "selected" : "")" @onclick="() => SelectAddress(address.Id)">
                                <input type="radio" name="address" value="@address.Id" @onchange="e => SelectAddress((int)e.Value!)" checked="@(_selectedAddressId == address.Id)" />
                                <div class="option-content">
                                    <strong>@address.RecipientName</strong>
                                    <span class="address-text">@address.Address1</span>
                                    @if (!string.IsNullOrEmpty(address.Address2))
                                    {
                                        <span class="address-text">@address.Address2</span>
                                    }
                                    <span class="address-text">@address.District، @address.City، @address.Province</span>
                                </div>
                                @if (address.IsDefault)
                                {
                                    <span class="badge-small">پیش‌فرض</span>
                                }
                            </div>
                        }
                    </div>
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="GoToAddAddress">افزودن آدرس جدید</button>
                }
                <div class="checkout-buttons">
                    <button class="btn btn-primary" type="button" disabled="@(_selectedAddressId is null)" @onclick="ConfirmCheckout">تایید و ادامه</button>
                    <button class="btn btn-ghost" type="button" @onclick="CancelAddressSelection">انصراف</button>
                </div>
            </div>
        }
        else if (_lines.Count == 0)
        {
            <div class="cart-empty">
                <Icon Name="shopping-cart" />
                <span>سبد خرید شما خالی است</span>
            </div>
        }
        else
        {
            @foreach (var line in _lines)
            {
                <div class="cart-item">
                    @if (!string.IsNullOrEmpty(line.Image))
                    {
                        <div class="cart-item-swatch"><img src="@line.Image" alt="@line.Name"></div>
                    }
                    else
                    {
                        <div class="cart-item-swatch" style="@SwatchStyle(line.Swatch)"><Icon Name="footprints" Class="mini-shoe" /></div>
                    }
                    <div class="cart-item-info">
                        <b>@line.Name</b>
                        <span>@line.Category · سایز @line.Size.ToFa()</span>
                        <div class="qty-stepper">
                            <button type="button" aria-label="کاهش تعداد" @onclick="() => ChangeQty(line.CartItemId, -1)">−</button>
                            <span>@line.Qty.ToFa()</span>
                            <button type="button" aria-label="افزایش تعداد" @onclick="() => ChangeQty(line.CartItemId, 1)">+</button>
                        </div>
                    </div>
                    <div class="cart-item-end">
                        <button class="cart-remove" type="button" aria-label="حذف از سبد" @onclick="() => Remove(line.CartItemId)">حذف</button>
                        <b class="cart-item-price">@line.LineTotal.FormatToman()</b>
                    </div>
                </div>
            }
        }
    </div>
    @if (_orderNumber is null && !_isAddressSelection)
    {
        <div class="cart-foot">
            <div class="cart-subtotal"><span>جمع کل</span><b>@Subtotal.FormatToman()</b></div>
            <button class="btn btn-primary cart-checkout" type="button" disabled="@(_lines.Count == 0)" @onclick="Checkout">تکمیل خرید</button>
            <p class="cart-note">این یک فروشگاه نمایشی است؛ پرداخت واقعی انجام نمی‌شود.</p>
        </div>
    }
</aside>

@code {
    private List<CartLine> _lines = [];
    private List<AddressLine> _addresses = [];
    private string? _orderNumber;
    private bool _isAddressSelection;
    private int? _selectedAddressId;
    private int? _userId;
    private long Subtotal => _lines.Sum(l => l.LineTotal);

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [Inject]
    private NavigationManager? Navigator { get; set; }

    protected override async Task OnInitializedAsync()
    {
        CartService.Changed += OnChanged;
        ExtractUserId();
        await Refresh();
    }

    private void ExtractUserId()
    {
        var userIdClaim = HttpContext?.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(userIdClaim, out var userId))
            _userId = userId;
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        await Refresh();
        StateHasChanged();
    });

    private async Task Refresh() => _lines = await CartService.GetLinesAsync();

    private async Task ChangeQty(int id, int delta)
    {
        var ok = await CartService.ChangeQtyAsync(id, delta);
        if (!ok && delta > 0)
            ToastService.ShowMessage("موجودی کافی نیست");
    }
    private async Task Remove(int id) => await CartService.RemoveItemAsync(id);

    private void Close()
    {
        _orderNumber = null;
        _isAddressSelection = false;
        CartService.CloseDrawer();
    }

    private async Task Checkout()
    {
        if (_userId is null)
            Navigator?.NavigateTo($"/account/login?returnUrl={Uri.EscapeDataString("/account")}");
        else
        {
            _addresses = await AddressService.GetUserAddressesAsync(_userId.Value);
            _selectedAddressId = _addresses.FirstOrDefault()?.Id;
            _isAddressSelection = true;
        }
    }

    private void SelectAddress(int addressId)
    {
        _selectedAddressId = addressId;
    }

    private async Task ConfirmCheckout()
    {
        if (!_selectedAddressId.HasValue)
            return;

        var (number, error) = await OrderService.CheckoutAsync(_userId, _selectedAddressId.Value);
        if (number is not null)
        {
            _orderNumber = number.ToFa();
            _isAddressSelection = false;
        }
        else if (error is not null)
        {
            ToastService.ShowMessage(error);
        }
    }

    private void CancelAddressSelection()
    {
        _isAddressSelection = false;
        _selectedAddressId = null;
    }

    private void GoToAddAddress()
    {
        Navigator?.NavigateTo("/account/address/new");
    }

    private static string SwatchStyle(string swatch)
    {
        var v = swatch switch { "accent-2" => "--accent-2", "ink" => "--ink", _ => "--accent" };
        return $"background:color-mix(in srgb, var({v}) 16%, var(--surface-2)); color:var({v})";
    }

    public void Dispose() => CartService.Changed -= OnChanged;
}
