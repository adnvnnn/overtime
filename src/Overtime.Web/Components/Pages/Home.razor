@page "/"
@inject ProductService ProductService
@inject BrandService BrandService
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["Home_PageTitle"]</PageTitle>

<div id="top"></div>
<section class="hero" id="home">
    <div class="wrap">
        <div>
            <p class="eyebrow">@Localizer["Home_HeroEyebrow"]</p>
            <h1>@((MarkupString)Localizer["Home_HeroTitle"].Value)</h1>
            <p class="lede hero-lede">
                @Localizer["Home_HeroLede"]
            </p>
            <div class="actions">
                <a class="btn btn-primary" href="/products">@Localizer["Nav_ViewProducts"]</a>
                <a class="btn btn-ghost" href="/about#location">@Localizer["Home_BranchAddressCta"]</a>
            </div>
            <div class="hero-stats">
                <div><b>@Localizer["Home_StatModelsCount"]</b><span>@Localizer["Home_StatModelsLabel"]</span></div>
                <div><b>@Localizer["Home_StatGuaranteeValue"]</b><span>@Localizer["Home_StatGuaranteeLabel"]</span></div>
                <div><b>@Localizer["Home_StatReturnValue"]</b><span>@Localizer["Home_StatReturnLabel"]</span></div>
            </div>
        </div>
        <div class="hero-art">
            <div class="badge">@Localizer["Home_HeroBadgeBrand"] <b>№06</b></div>
            <div class="ground"></div>
            <img class="shoe" src="assets/images/products/product-9.jpg" alt="Overtime №06">
        </div>
    </div>
</section>

<div class="ticker" aria-hidden="true">
    <div class="track">
        <span>@Localizer["Home_TickerShipping"]</span>
        <span>@Localizer["Home_TickerGuarantee"]</span>
        <span>@Localizer["Home_TickerNewModels"]</span>
        <span>@Localizer["Home_TickerReturns"]</span>
        <span>@Localizer["Home_TickerCod"]</span>
        <span>@Localizer["Home_TickerShipping"]</span>
        <span>@Localizer["Home_TickerGuarantee"]</span>
        <span>@Localizer["Home_TickerNewModels"]</span>
        <span>@Localizer["Home_TickerReturns"]</span>
        <span>@Localizer["Home_TickerCod"]</span>
    </div>
</div>

<Carousel />

<section id="categories">
    <div class="wrap">
        <div class="sec-head">
            <div>
                <p class="eyebrow">@Localizer["Common_Categories"]</p>
                <h2>@Localizer["Home_CategoriesHeading"]</h2>
            </div>
            <p class="lede">@Localizer["Home_CategoriesLede"]</p>
        </div>
        <div class="cats">
            <a class="cat" href="/products?cat=مردانه">
                <Icon Name="mars" Class="ic" />
                <b>@Localizer["Common_CategoryMen"]</b><span>Men</span>
            </a>
            <a class="cat" href="/products?cat=زنانه">
                <Icon Name="venus" Class="ic" />
                <b>@Localizer["Common_CategoryWomen"]</b><span>Women</span>
            </a>
            <a class="cat" href="/products?cat=بچگانه">
                <Icon Name="baby" Class="ic" />
                <b>@Localizer["Common_CategoryKids"]</b><span>Kids</span>
            </a>
            <a class="cat" href="/products?cat=لیمیتد">
                <Icon Name="gem" Class="ic" />
                <b>@Localizer["Common_CategoryLimited"]</b><span>Limited</span>
            </a>
        </div>
    </div>
</section>

<section id="products">
    <div class="wrap">
        <div class="sec-head">
            <div>
                <p class="eyebrow">@Localizer["Common_Products"]</p>
                <h2>@Localizer["Home_ProductsHeading"]</h2>
            </div>
            <div class="sec-head-actions">
                <a class="btn btn-primary btn-sm" href="/products">@Localizer["Nav_ViewAllProducts"]</a>
                <a class="btn btn-ghost btn-sm" href="https://www.instagram.com/overtime_sneaker/" target="_blank" rel="noopener">@Localizer["Home_ViewFullCollectionInsta"]</a>
            </div>
        </div>
        <div class="products">
            @foreach (var product in _topProducts)
            {
                <ProductCard Product="product" />
            }
        </div>
    </div>
</section>

<section id="instagram">
    <div class="wrap">
        <div class="insta">
            <div>
                <p class="eyebrow">@Localizer["Home_SocialEyebrow"]</p>
                <h2 class="insta-heading">@Localizer["Home_InstaHeading"]</h2>
                <a class="insta-handle" href="https://www.instagram.com/overtime_sneaker/" target="_blank" rel="noopener">
                    <Icon Name="camera" Class="ic" />
                    overtime_sneaker@@
                </a>
                <p class="lede">@Localizer["Home_InstaLede"]</p>
                <a class="btn btn-primary insta-cta" href="https://www.instagram.com/overtime_sneaker/" target="_blank" rel="noopener">@Localizer["Home_InstaCta"]</a>
            </div>
            <div class="grid6" aria-hidden="true">
                @foreach (var brand in _instaBrands)
                {
                    <div class="sq">
                        @if (!string.IsNullOrEmpty(brand.LogoUrl))
                        {
                            <img src="@brand.LogoUrl" alt="@brand.Name" loading="lazy" />
                        }
                        else
                        {
                            <b>@brand.Name</b>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private List<Product> _topProducts = [];
    private List<Brand> _instaBrands = [];

    protected override async Task OnInitializedAsync()
    {
        _topProducts = await ProductService.GetTopAsync(6);
        var allBrands = await BrandService.GetAllAsync();
        _instaBrands = [.. allBrands.OrderBy(_ => Random.Shared.Next()).Take(6)];
    }
}
