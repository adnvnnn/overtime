@page "/"
@inject ProductService ProductService
@inject BrandService BrandService
@inject BannerService BannerService
@inject IStringLocalizer<AppStrings> Localizer
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@Localizer["Home_PageTitle"]</PageTitle>

<div id="top"></div>
<section class="hero" id="home">
    <div class="wrap">
        <div>
            <p class="eyebrow">@Localizer["Home_HeroEyebrow"]</p>
            <h1>@((MarkupString)Localizer["Home_HeroTitle"].Value)</h1>
            <p class="lede hero-lede">
                @Localizer["Home_HeroLede"]
            </p>
            <div class="actions">
                <a class="btn btn-primary" href="/products">@Localizer["Nav_ViewProducts"]</a>
                <a class="btn btn-ghost" href="/about#location">@Localizer["Home_BranchAddressCta"]</a>
            </div>
            <div class="hero-stats">
                <div><b>@Localizer["Home_StatModelsCount", _inStockCount.ToFa()]</b><span>@Localizer["Home_StatModelsLabel"]</span></div>
                <div><b>@Localizer["Home_StatGuaranteeValue"]</b><span>@Localizer["Home_StatGuaranteeLabel"]</span></div>
                <div><b>@Localizer["Home_StatReturnValue"]</b><span>@Localizer["Home_StatReturnLabel"]</span></div>
            </div>
        </div>
        <div class="hero-art">
            <div class="hero-slides" @ref="_heroSlidesRef">
                @for (int i = 0; i < _heroBanners.Count; i++)
                {
                    var slide = _heroBanners[i];
                    <div class="hero-slide @(_heroIndex == i ? "active" : "")" aria-hidden="@(_heroIndex == i ? "false" : "true")">
                        <div class="badge">@Localizer["Home_HeroBadgeBrand"] <b>@slide.Badge</b></div>
                        <div class="ground"></div>
                        <img class="shoe" src="@slide.ImageUrl" alt="Overtime @slide.Badge" draggable="false">
                    </div>
                }
            </div>
            <div class="hero-dots">
                @for (int i = 0; i < _heroBanners.Count; i++)
                {
                    var index = i;
                    <button type="button" class="dot @(_heroIndex == index ? "active" : "")"
                            @onclick="() => GoToHeroSlide(index)"
                            aria-label="@Localizer["Home_HeroGoToSlideAria", index + 1]">
                    </button>
                }
            </div>
        </div>
    </div>
</section>

<div class="ticker" aria-hidden="true">
    <div class="track">
        <span>@Localizer["Home_TickerShipping"]</span>
        <span>@Localizer["Home_TickerGuarantee"]</span>
        <span>@Localizer["Home_TickerNewModels"]</span>
        <span>@Localizer["Home_TickerReturns"]</span>
        <span>@Localizer["Home_TickerCod"]</span>
        <span>@Localizer["Home_TickerShipping"]</span>
        <span>@Localizer["Home_TickerGuarantee"]</span>
        <span>@Localizer["Home_TickerNewModels"]</span>
        <span>@Localizer["Home_TickerReturns"]</span>
        <span>@Localizer["Home_TickerCod"]</span>
    </div>
</div>

<Carousel />

<section id="categories">
    <div class="wrap">
        <div class="sec-head">
            <div>
                <p class="eyebrow">@Localizer["Common_Categories"]</p>
                <h2>@Localizer["Home_CategoriesHeading"]</h2>
            </div>
            <p class="lede">@Localizer["Home_CategoriesLede"]</p>
        </div>
        <div class="cats">
            <a class="cat" href="/products?cat=men">
                <Icon Name="mars" Class="ic" />
                <b>@Localizer["Common_CategoryMen"]</b><span>Men</span>
            </a>
            <a class="cat" href="/products?cat=women">
                <Icon Name="venus" Class="ic" />
                <b>@Localizer["Common_CategoryWomen"]</b><span>Women</span>
            </a>
            <a class="cat" href="/products?cat=kids">
                <Icon Name="baby" Class="ic" />
                <b>@Localizer["Common_CategoryKids"]</b><span>Kids</span>
            </a>
            <a class="cat" href="/products?cat=limited-edition">
                <Icon Name="gem" Class="ic" />
                <b>@Localizer["Common_CategoryLimited"]</b><span>Limited</span>
            </a>
        </div>
    </div>
</section>

<section id="products">
    <div class="wrap">
        <div class="sec-head">
            <div>
                <p class="eyebrow">@Localizer["Common_Products"]</p>
                <h2>@Localizer["Home_ProductsHeading"]</h2>
            </div>
            <div class="sec-head-actions">
                <a class="btn btn-primary btn-sm" href="/products">@Localizer["Nav_ViewAllProducts"]</a>
                <a class="btn btn-ghost btn-sm" href="https://www.instagram.com/overtime_sneaker/" target="_blank" rel="noopener">@Localizer["Home_ViewFullCollectionInsta"]</a>
            </div>
        </div>
        <div class="products">
            @foreach (var product in _topProducts)
            {
                <ProductCard Product="product" />
            }
        </div>
    </div>
</section>

<section id="banners">
    <div class="wrap">
        <div class="sec-head">
            <div>
                <p class="eyebrow">@Localizer["Home_BannersEyebrow"]</p>
                <h2>@Localizer["Home_BannersHeading"]</h2>
            </div>
        </div>
        <div class="promo-banners">
            @foreach (var banner in _promoBanners)
            {
                <a class="promo-banner" href="@banner.LinkUrl">
                    <img src="@banner.ImageUrl" alt="@banner.Title" loading="lazy">
                    <div class="promo-banner-content">
                        @if (!string.IsNullOrEmpty(banner.Badge))
                        {
                            <span class="promo-banner-badge">@banner.Badge</span>
                        }
                        <h3>@banner.Title</h3>
                        @if (banner.Price is not null)
                        {
                            <span class="promo-banner-price">@banner.Price.Value.ToFa()<small>@Localizer["Common_Toman"]</small></span>
                        }
                        <span class="btn btn-primary btn-sm promo-banner-cta">@Localizer["Home_BannerCta"]</span>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<section id="instagram">
    <div class="wrap">
        <div class="insta">
            <div>
                <p class="eyebrow">@Localizer["Home_SocialEyebrow"]</p>
                <h2 class="insta-heading">@Localizer["Home_InstaHeading"]</h2>
                <a class="insta-handle" href="https://www.instagram.com/overtime_sneaker/" target="_blank" rel="noopener">
                    <Icon Name="camera" Class="ic" />
                    overtime_sneaker@@
                </a>
                <p class="lede">@Localizer["Home_InstaLede"]</p>
                <a class="btn btn-primary insta-cta" href="https://www.instagram.com/overtime_sneaker/" target="_blank" rel="noopener">@Localizer["Home_InstaCta"]</a>
            </div>
            <div class="grid6" aria-hidden="true">
                @foreach (var brand in _instaBrands)
                {
                    <div class="sq">
                        @if (!string.IsNullOrEmpty(brand.LogoUrl))
                        {
                            <img src="@brand.LogoUrl" alt="@brand.Name" loading="lazy" />
                        }
                        else
                        {
                            <b>@brand.Name</b>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private List<Banner> _heroBanners = [];
    private int _heroIndex = 0;
    private CancellationTokenSource? _heroSlideCts;
    private ElementReference _heroSlidesRef;
    private DotNetObjectReference<Home>? _heroDotNetRef;
    private IJSObjectReference? _heroGalleryHandle;

    private List<Product> _topProducts = [];
    private int _inStockCount;
    private List<Banner> _promoBanners = [];
    private List<Brand> _instaBrands = [];

    protected override async Task OnInitializedAsync()
    {
        var topProductsTask = ProductService.GetTopAsync(6);
        var inStockCountTask = ProductService.CountInStockAsync();
        var heroBannersTask = BannerService.GetActiveAsync(BannerKind.Hero);
        var promoBannersTask = BannerService.GetActiveAsync(BannerKind.Promo);
        var allBrandsTask = BrandService.GetAllAsync();
        await Task.WhenAll(topProductsTask, inStockCountTask, heroBannersTask, promoBannersTask, allBrandsTask);

        _topProducts = topProductsTask.Result;
        _inStockCount = inStockCountTask.Result;
        _heroBanners = heroBannersTask.Result;
        _promoBanners = promoBannersTask.Result;
        _instaBrands = [.. allBrandsTask.Result.OrderBy(_ => Random.Shared.Next()).Take(6)];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _heroDotNetRef = DotNetObjectReference.Create(this);
            _heroGalleryHandle = await JS.InvokeAsync<IJSObjectReference>("overtimeGallery.attach", _heroSlidesRef, _heroDotNetRef);

            _heroSlideCts = new CancellationTokenSource();
            _ = RunHeroAutoSlideAsync(_heroSlideCts.Token);
        }
    }

    private async Task RunHeroAutoSlideAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(4500, token);
                if (_heroBanners.Count == 0)
                    continue;
                _heroIndex = (_heroIndex + 1) % _heroBanners.Count;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void GoToHeroSlide(int index) => _heroIndex = index;

    [JSInvokable]
    public void OnSwipe(int direction)
    {
        if (_heroBanners.Count == 0)
            return;

        // overtimeGallery reports physical (LTR) drag direction; this page is RTL, so invert it.
        _heroIndex = ((_heroIndex - direction) % _heroBanners.Count + _heroBanners.Count) % _heroBanners.Count;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _heroSlideCts?.Cancel();
        _heroSlideCts?.Dispose();

        if (_heroGalleryHandle is not null)
        {
            try
            {
                await _heroGalleryHandle.InvokeVoidAsync("dispose");
                await _heroGalleryHandle.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
        _heroDotNetRef?.Dispose();
    }
}
