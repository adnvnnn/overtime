@page "/Error"
@using System.Diagnostics
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["Error_PageTitle"]</PageTitle>

<section class="state-page">
    <div class="wrap state-page-inner">
        <Icon Name="alert-circle" Class="ic" />
        <span class="state-eyebrow">@Localizer["Error_Eyebrow"]</span>
        <h1>@Localizer["Error_Heading"]</h1>
        <p>@Localizer["Error_Message"]</p>
        @if (ShowRequestId)
        {
            <p class="state-request-id">@Localizer["Error_RequestIdLabel"] <code>@RequestId</code></p>
        }
        <div class="state-actions">
            <a href="/" class="btn btn-primary">@Localizer["Error_HomeBtn"]</a>
        </div>
    </div>
</section>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
