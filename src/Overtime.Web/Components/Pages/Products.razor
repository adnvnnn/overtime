@page "/products"
@using System.Globalization
@inject ProductService ProductService
@inject BrandService BrandService
@inject CategoryService CategoryService
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["Products_PageTitle"]</PageTitle>

<div class="wrap">
    <nav class="breadcrumb" aria-label="@Localizer["Products_BreadcrumbAria"]">
        <a href="/">@Localizer["Common_Home"]</a>
        <span>/</span>
        <span class="cur">@Localizer["Common_Products"]</span>
    </nav>
</div>

<section class="catalog">
    <div class="wrap">
        <div class="sec-head">
            <div>
                <p class="eyebrow">@Localizer["Products_Eyebrow"]</p>
                <h1>@Localizer["Products_Heading"]</h1>
            </div>
            <p class="lede">@_countText</p>
        </div>

        <div class="catalog-toolbar">
            <label class="search-box">
                <Icon Name="search" Class="ic" />
                <input type="search" placeholder="@Localizer["Products_SearchPlaceholder"]" aria-label="@Localizer["Products_SearchAria"]" value="@_query" @oninput="OnSearchInput" />
            </label>
            <div class="filter-tabs" role="group" aria-label="@Localizer["Products_CategoryFilterAria"]">
                @foreach (var tab in _tabs)
                {
                    <button type="button" class="filter-tab @(_category == tab.Value ? "active" : "")" @onclick="() => SetCategory(tab.Value)">@tab.Label</button>
                }
            </div>
            <select class="brand-select" aria-label="@Localizer["Products_BrandFilterAria"]" value="@_brandSlug" @onchange="OnBrandChange">
                <option value="">@Localizer["Products_AllBrandsOption"]</option>
                @foreach (var brand in _allBrands)
                {
                    <option value="@brand.Slug">@brand.Name</option>
                }
            </select>
            <select class="sort-select" aria-label="@Localizer["Products_SortAria"]" value="@_sort" @onchange="OnSortChange">
                <option value="default">@Localizer["Products_SortDefault"]</option>
                <option value="price-asc">@Localizer["Products_SortPriceAsc"]</option>
                <option value="price-desc">@Localizer["Products_SortPriceDesc"]</option>
                <option value="name">@Localizer["Products_SortName"]</option>
            </select>
            <div class="price-filter">
                <div class="price-filter-values">
                    <span>@((_minPrice ?? _priceBounds.Min).ToFa()) @Localizer["Common_Toman"]</span>
                    <span class="price-filter-sep">@Localizer["Products_PriceRangeSep"]</span>
                    <span>@((_maxPrice ?? _priceBounds.Max).ToFa()) @Localizer["Common_Toman"]</span>
                </div>
                <div class="price-slider" style="--min-percent:@MinPercent; --max-percent:@MaxPercent;">
                    <div class="price-slider-track"></div>
                    <div class="price-slider-range"></div>
                    <input type="range" class="range-min" min="@_priceBounds.Min" max="@_priceBounds.Max" step="10000"
                           value="@(_minPrice ?? _priceBounds.Min)" @oninput="OnMinRangeInput" @onchange="OnPriceRangeCommit"
                           aria-label="@Localizer["Products_MinPriceAria"]" />
                    <input type="range" class="range-max" min="@_priceBounds.Min" max="@_priceBounds.Max" step="10000"
                           value="@(_maxPrice ?? _priceBounds.Max)" @oninput="OnMaxRangeInput" @onchange="OnPriceRangeCommit"
                           aria-label="@Localizer["Products_MaxPriceAria"]" />
                </div>
            </div>
            <label class="stock-filter">
                <input type="checkbox" checked="@_inStockOnly" @onchange="OnInStockChange" />
                <span>@Localizer["Products_InStockOnlyLabel"]</span>
            </label>
        </div>

        <div class="products">
            @foreach (var product in _products)
            {
                <ProductCard Product="product" />
            }
        </div>

        @if (_products.Count == 0)
        {
            <div class="catalog-empty">
                <Icon Name="search" Class="ic" />
                <p>@Localizer["Products_EmptyMessage"]</p>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="ResetFilters">@Localizer["Products_ClearFilters"]</button>
            </div>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "cat")]
    public string? CatQuery { get; set; }

    [SupplyParameterFromQuery(Name = "brand")]
    public string? BrandQuery { get; set; }

    private (string Value, string Label)[] _tabs = [];

    private string _category = "all";
    private string _query = "";
    private string _sort = "default";
    private long? _minPrice;
    private long? _maxPrice;
    private bool _inStockOnly;
    private (long Min, long Max) _priceBounds;
    private List<Product> _products = [];
    private int _totalCount;
    private string _countText = "";
    private string? _brandSlug;
    private List<Brand> _allBrands = [];

    private string MinPercent => FormatPercent(_minPrice ?? _priceBounds.Min);
    private string MaxPercent => FormatPercent(_maxPrice ?? _priceBounds.Max);

    private string FormatPercent(long value)
    {
        if (_priceBounds.Max <= _priceBounds.Min)
            return "0%";

        var pct = (double)(value - _priceBounds.Min) / (_priceBounds.Max - _priceBounds.Min) * 100;
        return pct.ToString("0.##", CultureInfo.InvariantCulture) + "%";
    }

    protected override async Task OnInitializedAsync()
    {
        var categories = await CategoryService.GetAllAsync();
        _tabs = [("all", Localizer["Products_TabAll"].Value), .. categories.Select(c => (c.Name, c.Name))];

        _totalCount = await ProductService.CountAllAsync();
        _priceBounds = await ProductService.GetPriceBoundsAsync();
        _allBrands = await BrandService.GetAllAsync();

        if (!string.IsNullOrEmpty(CatQuery) && _tabs.Any(t => t.Value == CatQuery))
            _category = CatQuery;

        if (!string.IsNullOrEmpty(BrandQuery) && _allBrands.Any(b => b.Slug == BrandQuery))
            _brandSlug = BrandQuery;

        await Refresh();
    }

    private async Task Refresh()
    {
        _products = await ProductService.GetCatalogAsync(_category, _query, _sort, _minPrice, _maxPrice, _inStockOnly, _brandSlug);
        _countText = Localizer["Products_CountText", _products.Count.ToFa(), _totalCount.ToFa()].Value;
    }

    private async Task OnBrandChange(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _brandSlug = string.IsNullOrEmpty(value) ? null : value;
        await Refresh();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        await Refresh();
    }

    private async Task OnSortChange(ChangeEventArgs e)
    {
        _sort = e.Value?.ToString() ?? "default";
        await Refresh();
    }

    private async Task SetCategory(string cat)
    {
        _category = cat;
        await Refresh();
    }

    private void OnMinRangeInput(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var value))
            _minPrice = Math.Min(value, _maxPrice ?? _priceBounds.Max);
    }

    private void OnMaxRangeInput(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var value))
            _maxPrice = Math.Max(value, _minPrice ?? _priceBounds.Min);
    }

    private async Task OnPriceRangeCommit() => await Refresh();

    private async Task OnInStockChange(ChangeEventArgs e)
    {
        _inStockOnly = e.Value is bool value && value;
        await Refresh();
    }

    private async Task ResetFilters()
    {
        _category = "all";
        _query = "";
        _sort = "default";
        _minPrice = null;
        _maxPrice = null;
        _inStockOnly = false;
        _brandSlug = null;
        await Refresh();
    }
}
