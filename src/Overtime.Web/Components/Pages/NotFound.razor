@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["NotFound_PageTitle"]</PageTitle>

<section class="state-page">
    <div class="wrap state-page-inner">
        <Icon Name="footprints" Class="ic" />
        <span class="state-eyebrow">@Localizer["NotFound_Eyebrow"]</span>
        <h1>@Localizer["NotFound_Heading"]</h1>
        <p>@Localizer["NotFound_Message"]</p>
        <div class="state-actions">
            <a href="/" class="btn btn-primary">@Localizer["NotFound_HomeBtn"]</a>
            <a href="/products" class="btn btn-ghost">@Localizer["NotFound_ProductsBtn"]</a>
        </div>
    </div>
</section>
