@page "/account/address/new"
@page "/account/address/{AddressId:int}"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@inject AddressService AddressService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>Overtime | @(IsNew ? Localizer["AddressForm_AddTitle"] : Localizer["AddressForm_EditTitle"])</PageTitle>

<div class="wrap">
    <nav class="breadcrumb" aria-label="@Localizer["Products_BreadcrumbAria"]">
        <a href="/">@Localizer["Common_Home"]</a>
        <span>/</span>
        <a href="/account">@Localizer["Common_Account"]</a>
        <span>/</span>
        <span class="cur">@(IsNew ? Localizer["AddressForm_NewAddressBreadcrumb"] : Localizer["AddressForm_EditTitle"])</span>
    </nav>
</div>

<section class="account-section">
    <div class="wrap">
        <div class="address-form-container">
            <h1>@(IsNew ? Localizer["AddressForm_AddHeading"] : Localizer["AddressForm_EditTitle"])</h1>

            <EditForm Model="FormModel" FormName="address-form" OnValidSubmit="SaveAddress" class="address-form">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label>@Localizer["AddressForm_RecipientNameLabel"]</label>
                    <InputText @bind-Value="FormModel.RecipientName" placeholder="@Localizer["AddressForm_FullNamePlaceholder"]" />
                    <ValidationMessage For="() => FormModel.RecipientName" />
                </div>

                <div class="form-group">
                    <label>@Localizer["AddressForm_PhoneLabel"]</label>
                    <InputText @bind-Value="FormModel.PhoneNumber" type="tel" placeholder="@Localizer["AddressForm_PhonePlaceholder"]" dir="ltr" />
                    <ValidationMessage For="() => FormModel.PhoneNumber" />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>@Localizer["AddressForm_ProvinceLabel"]</label>
                        <InputText @bind-Value="FormModel.Province" placeholder="@Localizer["AddressForm_ProvincePlaceholder"]" />
                        <ValidationMessage For="() => FormModel.Province" />
                    </div>
                    <div class="form-group">
                        <label>@Localizer["AddressForm_CityLabel"]</label>
                        <InputText @bind-Value="FormModel.City" placeholder="@Localizer["AddressForm_CityPlaceholder"]" />
                        <ValidationMessage For="() => FormModel.City" />
                    </div>
                </div>

                <div class="form-group">
                    <label>@Localizer["AddressForm_DistrictLabel"]</label>
                    <InputText @bind-Value="FormModel.District" placeholder="@Localizer["AddressForm_DistrictPlaceholder"]" />
                    <ValidationMessage For="() => FormModel.District" />
                </div>

                <div class="form-group">
                    <label>@Localizer["AddressForm_Address1Label"]</label>
                    <InputText @bind-Value="FormModel.Address1" placeholder="@Localizer["AddressForm_Address1Placeholder"]" />
                    <ValidationMessage For="() => FormModel.Address1" />
                </div>

                <div class="form-group">
                    <label>@Localizer["AddressForm_Address2Label"]</label>
                    <InputText @bind-Value="FormModel.Address2" placeholder="@Localizer["AddressForm_Address2Placeholder"]" />
                </div>

                <div class="form-group">
                    <label>@Localizer["AddressForm_PostalCodeLabel"]</label>
                    <InputText @bind-Value="FormModel.PostalCode" placeholder="@Localizer["AddressForm_PostalCodePlaceholder"]" dir="ltr" />
                    <ValidationMessage For="() => FormModel.PostalCode" />
                </div>

                <div class="form-group checkbox">
                    <InputCheckbox @bind-Value="FormModel.IsDefault" />
                    <label>@Localizer["AddressForm_SetDefaultLabel"]</label>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">@(IsNew ? Localizer["AddressForm_AddBtn"] : Localizer["AddressForm_SaveBtn"])</button>
                    <button type="button" class="btn btn-ghost" @onclick="Cancel">@Localizer["Common_Cancel"]</button>
                </div>
            </EditForm>
        </div>
    </div>
</section>

@code {
    [Parameter]
    public int? AddressId { get; set; }

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    public AddressFormModel FormModel { get; set; } = new();

    private int _userId;
    private bool IsNew => AddressId is null;

    protected override async Task OnInitializedAsync()
    {
        var userIdClaim = HttpContext?.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(userIdClaim, out _userId))
            NavigationManager.NavigateTo("/account/login");
        else if (!IsNew)
            await LoadAddress();
    }

    private async Task LoadAddress()
    {
        var address = await AddressService.GetAddressAsync(AddressId!.Value, _userId);
        if (address is not null)
        {
            FormModel.RecipientName = address.RecipientName;
            FormModel.PhoneNumber = address.PhoneNumber;
            FormModel.Province = address.Province;
            FormModel.City = address.City;
            FormModel.District = address.District;
            FormModel.Address1 = address.Address1;
            FormModel.Address2 = address.Address2;
            FormModel.PostalCode = address.PostalCode;
            FormModel.IsDefault = address.IsDefault;
        }
        else
            NavigationManager.NavigateTo("/account");
    }

    private async Task SaveAddress()
    {
        if (IsNew)
        {
            await AddressService.AddAddressAsync(_userId, FormModel.RecipientName, FormModel.PhoneNumber,
                FormModel.Province, FormModel.City, FormModel.District, FormModel.Address1,
                FormModel.Address2, FormModel.PostalCode, FormModel.IsDefault);
        }
        else
        {
            await AddressService.UpdateAddressAsync(AddressId!.Value, _userId, FormModel.RecipientName,
                FormModel.PhoneNumber, FormModel.Province, FormModel.City, FormModel.District,
                FormModel.Address1, FormModel.Address2, FormModel.PostalCode, FormModel.IsDefault);
        }

        NavigationManager.NavigateTo("/account");
    }

    private void Cancel() => NavigationManager.NavigateTo("/account");

    public class AddressFormModel
    {
        [Required(ErrorMessageResourceType = typeof(AppStrings), ErrorMessageResourceName = nameof(AppStrings.Validation_RecipientNameRequired))]
        public string RecipientName { get; set; } = "";

        [Required(ErrorMessageResourceType = typeof(AppStrings), ErrorMessageResourceName = nameof(AppStrings.Validation_PhoneRequired))]
        public string PhoneNumber { get; set; } = "";

        [Required(ErrorMessageResourceType = typeof(AppStrings), ErrorMessageResourceName = nameof(AppStrings.Validation_ProvinceRequired))]
        public string Province { get; set; } = "";

        [Required(ErrorMessageResourceType = typeof(AppStrings), ErrorMessageResourceName = nameof(AppStrings.Validation_CityRequired))]
        public string City { get; set; } = "";

        [Required(ErrorMessageResourceType = typeof(AppStrings), ErrorMessageResourceName = nameof(AppStrings.Validation_DistrictRequired))]
        public string District { get; set; } = "";

        [Required(ErrorMessageResourceType = typeof(AppStrings), ErrorMessageResourceName = nameof(AppStrings.Validation_Address1Required))]
        public string Address1 { get; set; } = "";

        public string? Address2 { get; set; }

        [Required(ErrorMessageResourceType = typeof(AppStrings), ErrorMessageResourceName = nameof(AppStrings.Validation_PostalCodeRequired))]
        public string PostalCode { get; set; } = "";

        public bool IsDefault { get; set; }
    }
}
