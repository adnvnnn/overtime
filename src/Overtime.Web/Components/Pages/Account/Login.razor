@page "/account/login"
@attribute [ExcludeFromInteractiveRouting]
@inject OtpService OtpService
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Env
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["Login_PageTitle"]</PageTitle>

<div class="wrap">
    <nav class="breadcrumb" aria-label="@Localizer["Products_BreadcrumbAria"]">
        <a href="/">@Localizer["Common_Home"]</a>
        <span>/</span>
        <span class="cur">@Localizer["Common_LoginRegister"]</span>
    </nav>
</div>

<section class="auth-section">
    <div class="wrap">
        <div class="auth-card">
            <p class="eyebrow">@Localizer["Common_Account"]</p>
            <h1>@(IsVerifyStep ? Localizer["Login_VerifyHeading"] : Localizer["Login_LoginHeading"])</h1>
            <p class="lede auth-lede">
                @if (IsVerifyStep)
                {
                    <text>@Localizer["Login_VerifyLedePrefix"] <b dir="ltr">@Phone</b> @Localizer["Login_VerifyLedeSuffix"]</text>
                }
                else
                {
                    <text>@Localizer["Login_LoginLede"]</text>
                }
            </p>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="auth-alert">@_error</div>
            }
            @if (Env.IsDevelopment() && !string.IsNullOrEmpty(Dev))
            {
                <div class="auth-dev-hint">
                    @Localizer["Login_DevHintPrefix"] <b dir="ltr">@Dev</b>
                </div>
            }

            @if (!IsVerifyStep)
            {
                <EditForm Model="PhoneModel" FormName="request-otp" OnValidSubmit="RequestCode" class="auth-form">
                    <DataAnnotationsValidator />
                    <label class="auth-field">
                        <span>@Localizer["Login_PhoneFieldLabel"]</span>
                        <InputText @bind-Value="PhoneModel.Phone" type="tel" inputmode="numeric" dir="ltr" placeholder="@Localizer["AddressForm_PhonePlaceholder"]" autofocus />
                        <ValidationMessage For="() => PhoneModel.Phone" />
                    </label>
                    <button type="submit" class="btn btn-primary auth-submit">@Localizer["Login_RequestCodeBtn"]</button>
                </EditForm>
            }
            else
            {
                <EditForm Model="OtpModel" FormName="verify-otp" OnValidSubmit="VerifyCode" class="auth-form">
                    <DataAnnotationsValidator />
                    <label class="auth-field">
                        <span>@Localizer["Login_CodeFieldLabel"]</span>
                        <InputText @bind-Value="OtpModel.Code" inputmode="numeric" dir="ltr" maxlength="6" placeholder="------" autofocus />
                        <ValidationMessage For="() => OtpModel.Code" />
                    </label>
                    <button type="submit" class="btn btn-primary auth-submit">@Localizer["Login_VerifyBtn"]</button>
                </EditForm>

                <EditForm Model="ResendModel" FormName="resend-otp" OnValidSubmit="ResendCode" class="auth-resend-form">
                    <button type="submit" class="btn btn-ghost btn-sm">@Localizer["Login_ResendBtn"]</button>
                </EditForm>
                <a class="auth-change-phone" href="/account/login">@Localizer["Login_ChangePhoneLink"]</a>
            }
        </div>
    </div>
</section>
