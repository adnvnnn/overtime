@page "/account/login"
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject OtpService OtpService
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Env
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["Login_PageTitle"]</PageTitle>

<div class="wrap">
    <nav class="breadcrumb" aria-label="@Localizer["Products_BreadcrumbAria"]">
        <a href="/">@Localizer["Common_Home"]</a>
        <span>/</span>
        <span class="cur">@Localizer["Common_LoginRegister"]</span>
    </nav>
</div>

<section class="auth-section">
    <div class="wrap">
        <div class="auth-card">
            <p class="eyebrow">@Localizer["Common_Account"]</p>
            <h1>@(IsVerifyStep ? Localizer["Login_VerifyHeading"] : Localizer["Login_LoginHeading"])</h1>
            <p class="lede auth-lede">
                @if (IsVerifyStep)
                {
                    <text>@Localizer["Login_VerifyLedePrefix"] <b dir="ltr">@Phone</b> @Localizer["Login_VerifyLedeSuffix"]</text>
                }
                else
                {
                    <text>@Localizer["Login_LoginLede"]</text>
                }
            </p>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="auth-alert">@_error</div>
            }
            @if (Env.IsDevelopment() && !string.IsNullOrEmpty(Dev))
            {
                <div class="auth-dev-hint">
                    @Localizer["Login_DevHintPrefix"] <b dir="ltr">@Dev</b>
                </div>
            }

            @if (!IsVerifyStep)
            {
                <EditForm Model="PhoneModel" FormName="request-otp" OnValidSubmit="RequestCode" class="auth-form">
                    <DataAnnotationsValidator />
                    <label class="auth-field">
                        <span>@Localizer["Login_PhoneFieldLabel"]</span>
                        <InputText @bind-Value="PhoneModel.Phone" type="tel" inputmode="numeric" dir="ltr" placeholder="@Localizer["AddressForm_PhonePlaceholder"]" autofocus />
                        <ValidationMessage For="() => PhoneModel.Phone" />
                    </label>
                    <button type="submit" class="btn btn-primary auth-submit">@Localizer["Login_RequestCodeBtn"]</button>
                </EditForm>
            }
            else
            {
                <EditForm Model="OtpModel" FormName="verify-otp" OnValidSubmit="VerifyCode" class="auth-form">
                    <DataAnnotationsValidator />
                    <label class="auth-field">
                        <span>@Localizer["Login_CodeFieldLabel"]</span>
                        <InputText @bind-Value="OtpModel.Code" inputmode="numeric" dir="ltr" maxlength="6" placeholder="------" autofocus />
                        <ValidationMessage For="() => OtpModel.Code" />
                    </label>
                    <button type="submit" class="btn btn-primary auth-submit">@Localizer["Login_VerifyBtn"]</button>
                </EditForm>

                <EditForm Model="ResendModel" FormName="resend-otp" OnValidSubmit="ResendCode" class="auth-resend-form">
                    <button type="submit" class="btn btn-ghost btn-sm">@Localizer["Login_ResendBtn"]</button>
                </EditForm>
                <a class="auth-change-phone" href="/account/login">@Localizer["Login_ChangePhoneLink"]</a>
            }
        </div>
    </div>
</section>

@code {
    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "step")]
    public string? Step { get; set; }

    [SupplyParameterFromQuery(Name = "phone")]
    public string? Phone { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "dev")]
    public string? Dev { get; set; }

    [SupplyParameterFromForm(FormName = "request-otp")]
    public PhoneInputModel PhoneModel { get; set; } = new();

    [SupplyParameterFromForm(FormName = "verify-otp")]
    public OtpInputModel OtpModel { get; set; } = new();

    [SupplyParameterFromForm(FormName = "resend-otp")]
    public ResendInputModel ResendModel { get; set; } = new();

    private string? _error;

    private bool IsVerifyStep => Step == "verify" && !string.IsNullOrEmpty(Phone);

    protected override void OnInitialized()
    {
        if (HttpContext.User.Identity?.IsAuthenticated == true)
            NavigationManager.NavigateTo(SafeReturnUrl(), replace: true);
    }

    private async Task RequestCode()
    {
        var phone = OtpService.NormalizePhone(PhoneModel.Phone);
        if (!OtpService.IsValidPhone(phone))
        {
            _error = Localizer["Login_InvalidPhoneError"].Value;
            return;
        }

        await SendCodeAndRedirect(phone);
    }

    private async Task ResendCode()
    {
        var phone = Phone ?? "";
        await SendCodeAndRedirect(phone);
    }

    private async Task SendCodeAndRedirect(string phone)
    {
        var (ok, error, debugCode) = await OtpService.RequestCodeAsync(phone);
        if (!ok)
        {
            _error = error;
            return;
        }

        var url = $"/account/login?step=verify&phone={Uri.EscapeDataString(phone)}&returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}";
        if (Env.IsDevelopment() && debugCode is not null)
            url += $"&dev={debugCode}";

        NavigationManager.NavigateTo(url, replace: true);
    }

    private async Task VerifyCode()
    {
        var phone = Phone ?? "";
        var code = OtpService.NormalizePhone(OtpModel.Code);

        var (ok, error, user) = await OtpService.VerifyCodeAsync(phone, code);
        if (!ok || user is null)
        {
            _error = error;
            return;
        }

        var claims = new List<Claim>
        {
            new(ClaimTypes.NameIdentifier, user.Id.ToString()),
            new(ClaimTypes.MobilePhone, user.PhoneNumber),
        };
        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, new ClaimsPrincipal(identity));

        NavigationManager.NavigateTo(SafeReturnUrl(), replace: true);
    }

    private string SafeReturnUrl() =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//")
            ? ReturnUrl
            : "/";

    public class PhoneInputModel
    {
        [Required(ErrorMessageResourceType = typeof(AppStrings), ErrorMessageResourceName = nameof(AppStrings.Validation_LoginPhoneRequired))]
        public string Phone { get; set; } = "";
    }

    public class OtpInputModel
    {
        [Required(ErrorMessageResourceType = typeof(AppStrings), ErrorMessageResourceName = nameof(AppStrings.Validation_OtpCodeRequired))]
        [StringLength(6, MinimumLength = 6, ErrorMessageResourceType = typeof(AppStrings), ErrorMessageResourceName = nameof(AppStrings.Validation_OtpCodeLength))]
        public string Code { get; set; } = "";
    }

    public class ResendInputModel;
}
