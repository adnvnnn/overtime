@page "/account"
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@inject AddressService AddressService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["Account_PageTitle"]</PageTitle>

<div class="wrap">
    <nav class="breadcrumb" aria-label="@Localizer["Products_BreadcrumbAria"]">
        <a href="/">@Localizer["Common_Home"]</a>
        <span>/</span>
        <span class="cur">@Localizer["Common_Account"]</span>
    </nav>
</div>

<section class="account-section">
    <div class="wrap">
        <AccountTabs />

        <div class="account-header">
            <h1>@Localizer["Account_AddressesHeading"]</h1>
            <button class="btn btn-primary" @onclick="GoToAddAddress">@Localizer["Cart_AddNewAddress"]</button>
        </div>

        @if (_addresses.Count == 0)
        {
            <div class="account-empty">
                <p>@Localizer["Account_NoAddressesMessage"]</p>
            </div>
        }
        else
        {
            <div class="address-list">
                @foreach (var address in _addresses)
                {
                    <div class="address-card @(address.IsDefault ? "default" : "")">
                        @if (address.IsDefault)
                        {
                            <span class="badge">@Localizer["Account_DefaultAddressBadge"]</span>
                        }
                        <div class="address-content">
                            <h3>@address.RecipientName</h3>
                            <p>@address.Address1</p>
                            @if (!string.IsNullOrEmpty(address.Address2))
                            {
                                <p>@address.Address2</p>
                            }
                            <p>@address.District، @address.City، @address.Province</p>
                            <p class="postal">@Localizer["Account_PostalCodeLabel"] @address.PostalCode</p>
                            <p class="phone">@Localizer["Account_PhoneLabel"] @address.PhoneNumber</p>
                        </div>
                        @if (_pendingDeleteId == address.Id)
                        {
                            <div class="address-confirm">
                                <span>@Localizer["Account_ConfirmDeleteQuestion"]</span>
                                <div class="address-actions">
                                    <button class="btn btn-primary btn-sm" @onclick="() => ConfirmDeleteAddress(address.Id)">@Localizer["Account_ConfirmDeleteYes"]</button>
                                    <button class="btn btn-ghost btn-sm" @onclick="CancelDelete">@Localizer["Common_Cancel"]</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="address-actions">
                                <button class="btn btn-ghost btn-sm" @onclick="() => GoToEditAddress(address.Id)">@Localizer["Account_EditBtn"]</button>
                                <button class="btn btn-ghost btn-sm" @onclick="() => RequestDelete(address.Id)">@Localizer["Cart_RemoveBtn"]</button>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    private List<AddressLine> _addresses = [];
    private int _userId;
    private int? _pendingDeleteId;

    protected override async Task OnInitializedAsync()
    {
        var userIdClaim = HttpContext?.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(userIdClaim, out _userId))
            NavigationManager.NavigateTo("/account/login");
        else
            await LoadAddresses();
    }

    private async Task LoadAddresses()
    {
        _addresses = await AddressService.GetUserAddressesAsync(_userId);
    }

    private void GoToAddAddress() => NavigationManager.NavigateTo("/account/address/new");

    private void GoToEditAddress(int addressId) => NavigationManager.NavigateTo($"/account/address/{addressId}");

    private void RequestDelete(int addressId) => _pendingDeleteId = addressId;

    private void CancelDelete() => _pendingDeleteId = null;

    private async Task ConfirmDeleteAddress(int addressId)
    {
        _pendingDeleteId = null;
        await AddressService.DeleteAddressAsync(addressId, _userId);
        await LoadAddresses();
    }
}
