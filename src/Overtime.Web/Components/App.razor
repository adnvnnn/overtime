@inject IStringLocalizer<AppStrings> Localizer
<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Localizer["Home_PageTitle"]</title>
    <meta name="description" content="@Localizer["App_MetaDescription"]" />
    <base href="/" />
    <script src="js/theme-init.js"></script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["assets/css/index.css"]" />
    <link rel="stylesheet" href="@Assets["assets/css/products.css"]" />
    <link rel="stylesheet" href="@Assets["assets/css/product.css"]" />
    <link rel="stylesheet" href="@Assets["assets/css/account.css"]" />
    <link rel="stylesheet" href="@Assets["Overtime.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="js/interop.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? RenderMode.InteractiveServer : null;
}
